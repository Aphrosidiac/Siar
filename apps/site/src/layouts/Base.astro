---
import '../styles/global.css';
import '../styles/marketing.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_URL, DESCRIPTION } from '../config';
import { orgLd, websiteLd } from '../lib/seo';
import { FONT_FACES, FONT_FILES } from '../lib/fonts';

interface Props {
  title: string;
  description?: string;
  jsonLd?: object[];
  noindex?: boolean;
  ogType?: string;
  bare?: boolean;
}
const { title, description = DESCRIPTION, jsonLd = [], noindex = false, ogType = 'website', bare = false } = Astro.props;
/** Malay pages are not translations (docs/seo/ACCEPTANCE.md): lang ms, og:locale ms_MY, no hreflang. */
const ms = Astro.url.pathname.startsWith('/ms/');
const fullTitle = /siar/i.test(title) ? title : `${title} | ${SITE_NAME}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = `${SITE_URL}${path === '/' ? '' : path}`;
const ld = [orgLd(), ...(path === '/' ? [websiteLd()] : []), ...jsonLd];
---
<!doctype html>
<html lang={ms ? 'ms' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f3efe4" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ms ? 'ms_MY' : 'en_US'} />
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Siar: write it once, Siar it everywhere. The unified social media API where every post is accounted for." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE_URL}/og.png`} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <script is:inline define:vars={{ FONT_FACES, FONT_FILES }}>
      (function () {
        // First page in a tab: paint in the size-matched fallback, then download Plex into the cache without
        // applying it (no swap, no shift). Later pages in the tab apply Plex at once from the cache.
        var seen = false;
        try { seen = sessionStorage.getItem('siar-fonts') === '1'; } catch (e) {}
        if (seen) { var st = document.createElement('style'); st.textContent = FONT_FACES; document.head.appendChild(st); return; }
        var done = false;
        function warm() { if (done) return; done = true; FONT_FILES.forEach(function (u) { try { fetch(u).catch(function () {}); } catch (e) {} }); }
        try { new PerformanceObserver(function (l, o) { if (l.getEntriesByName('first-contentful-paint').length) { o.disconnect(); setTimeout(warm, 0); } }).observe({ type: 'paint', buffered: true }); } catch (e) {}
        setTimeout(warm, 3000);
        addEventListener('load', function () { try { sessionStorage.setItem('siar-fonts', '1'); } catch (e) {} });
      })();
    </script>
    <noscript><style set:html={FONT_FACES}></style></noscript>
    <script is:inline>
      document.documentElement.classList.add('js');
      document.documentElement.dataset.theme = 'light';
      try { if (localStorage.getItem('siar-theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}
    </script>
    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {!bare && <Header />}
    <main id="main"><slot /></main>
    {!bare && <Footer />}
    <script>
      import '../scripts/reveal';
    </script>
    {!bare && (
      <script is:inline>
        // Analytics (docs/ANALYTICS.md). Remembers where this browser first came from (siar_ft, read once at signup)
        // and tells /_e that a real browser ran this page: after the first interaction, or 3 s with the tab visible.
        // nginx logs /_e and the API matches it to the page view; a view without it stays "unconfirmed".
        (function () {
          try {
            var d = document, l = location, n = navigator, q = new URLSearchParams(l.search), ref = '';
            try { if (d.referrer) { var u = new URL(d.referrer); if (u.hostname !== l.hostname) ref = u.hostname; } } catch (e) {}
            var us = q.get('utm_source') || '', um = q.get('utm_medium') || '', uc = q.get('utm_campaign') || '';
            if (!/(?:^|; )siar_ft=/.test(d.cookie)) {
              var host = l.hostname.replace(/^www\./, '');
              var ft = encodeURIComponent(JSON.stringify({ r: ref, s: us, m: um, c: uc, p: l.pathname, t: Date.now() }));
              d.cookie = 'siar_ft=' + ft + '; path=/; max-age=15552000; samesite=lax' + (host.indexOf('.') > 0 ? '; domain=' + host + '; secure' : '');
            }
            var sent = false;
            var send = function (e) {
              if (sent) return; sent = true;
              var p = '/_e?p=' + encodeURIComponent(l.pathname) + '&r=' + encodeURIComponent(ref) + '&us=' + encodeURIComponent(us) + '&um=' + encodeURIComponent(um) + '&uc=' + encodeURIComponent(uc) + '&w=' + (window.innerWidth || 0) + '&wd=' + (n.webdriver ? 1 : 0) + '&e=' + e;
              if (n.sendBeacon) n.sendBeacon(p); else new Image().src = p;
            };
            ['pointerdown', 'keydown', 'scroll', 'touchstart', 'mousemove'].forEach(function (t) { addEventListener(t, function () { send('i'); }, { once: true, passive: true }); });
            setTimeout(function () { if (d.visibilityState === 'visible') send('t'); }, 3000);
          } catch (e) {}
        })();
      </script>
    )}
    <script is:inline>
      (function () {
        var b = document.querySelector('[data-theme-toggle]');
        if (!b) return;
        b.addEventListener('click', function () {
          var root = document.documentElement;
          var cur = root.dataset.theme === 'dark' ? 'dark' : 'light';
          var next = cur === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('siar-theme', next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
