---
import Base from '../layouts/Base.astro';
import NetIcon from '../components/NetIcon.astro';
import CodeTabs from '../components/CodeTabs.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Faq from '../components/Faq.astro';
import Flow from '../components/home/Flow.astro';
import HeroFan from '../components/home/HeroFan.astro';
import PriceCalc from '../components/home/PriceCalc.astro';
import { NETWORKS } from '../lib/networks';
import { OP_COUNT } from '../lib/openapi';
import { PLANS, money, PRICE_LOCK } from '../lib/plans';
import { postTabs } from '../lib/snippets';
import { softwareLd, faqLd } from '../lib/seo';
import { NETWORK_STATUS, CANONICAL, OPEN_LIST, type Status } from '../lib/status';
import { SIGNUP_URL, LEGAL_NAME, LEGAL_REG } from '../config';

const N = NETWORKS.length;
const usd = (t: 'STARTER' | 'PRO' | 'BUSINESS') => money(t, 'MONTHLY', 'usd');
const rm = (t: 'STARTER' | 'PRO' | 'BUSINESS') => money(t, 'MONTHLY', 'myr');
const free = PLANS.FREE.posts;

/** Open first, then waiting, then not open; each tile carries its exact status line. */
const ORDER: Record<Status, number> = { open: 0, partial: 1, waiting: 2, 'not-open': 3 };
const tiles = [...NETWORKS].sort((a, b) => ORDER[NETWORK_STATUS[a.type].status] - ORDER[NETWORK_STATUS[b.type].status]);

const faq = [
  { q: 'What is a unified social media API?', a: 'A unified social media API is one API that publishes to many social networks through a single request format, one key and one set of webhooks. You stop maintaining a separate integration, login flow and error handler for each network. Siar is one: it adds a check before sending and a signed result after.' },
  { q: 'What is Siar?', a: CANONICAL },
  { q: 'Which social networks does Siar support?', a: `Publishing is open today on ${OPEN_LIST}. YouTube uploads work, and public visibility is not yet confirmed. TikTok, Pinterest publishing and LinkedIn company pages are waiting on those networks' approval. Reddit, Snapchat and Google Business Profile are built but not open yet. <a href="/platforms">Every network's status, with dates</a>.` },
  { q: 'How is Siar priced?', a: `Per organization, never per connected account. Start with ${free} free posts to try. Then Starter is ${usd('STARTER')} a month (${rm('STARTER')} in Malaysia) for 1 brand, Pro ${usd('PRO')} (${rm('PRO')}) for 10 brands, and Business ${usd('BUSINESS')} (${rm('BUSINESS')}) for unlimited brands. Yearly is 10 times monthly. ${PRICE_LOCK} <a href="/pricing">See every plan</a>.` },
  { q: 'Is there a free plan?', a: `Siar starts with ${free} free posts to try. It is a one-time allowance, not a monthly one: no card, no time limit, and it does not refill. Free includes the API, webhooks and comments, but no analytics. After that, Starter is ${usd('STARTER')} a month (${rm('STARTER')} in Malaysia).` },
  { q: 'Can my customers connect their own accounts?', a: 'Yes. Create a brand for each customer and send them a branded connect link with your name, logo and color. They sign in to each network in their own browser and come back to your app. You never see a password or token. The page says "Powered by Siar" and is in English.' },
  { q: 'Do I need my own developer app on each network?', a: "Not for the networks that are open today. Facebook, Instagram and Threads connect through Siar's Meta app, which passed Meta's App Review on 27 October 2026. X, LinkedIn profiles, Bluesky, Mastodon, Discord and Slack connect through Siar's own live apps. Each network page lists what the account itself needs." },
  { q: 'What happens if a post fails on one network?', a: "The other networks still publish. The failed one keeps the network's own code and message, with a plain-English fix from Siar's error reference. A signed <code>post.published</code> webhook tells your server each network's result. Fix the cause and retry: only the failed networks are sent again, and the retry does not use another post." },
  { q: 'How do I know a post was published?', a: "Subscribe to the <code>post.published</code> webhook. It fires when the whole post has published or failed, with each network's result, link and error. Every delivery is HMAC-signed. If your server does not answer, Siar retries 7 times over about 45 hours, and you can inspect and resend deliveries from the log." },
  { q: 'Can a retry post the same thing twice?', a: 'Siar claims each network target once, so retries, restarts and double clicks cannot publish the same post again. An interrupted send is checked against the account before anything is re-sent. There is no idempotency key on post creation, though: resending the create call makes a second post, so check by your own reference first.' },
  { q: 'What happens when a token expires?', a: 'Siar flags a connection when the network revokes the grant or it is about to expire, and sends a <code>social-account.updated</code> webhook. A post to that account fails with "Reconnect this account, then retry the post." Your customer reconnects through the same connect link, and you retry the post.' },
  { q: 'Can I post to TikTok?', a: `Not yet. TikTok's audit of Siar's app has not passed, so TikTok stays closed until it does. Siar shows each network's status, with dates, on its <a href="/platforms">networks page</a>. Open today: ${OPEN_LIST}.` },
  { q: 'Who makes Siar?', a: `Siar is made by ${LEGAL_NAME} (SSM ${LEGAL_REG}), a software studio in Malaysia, and has been live since 12 October 2026. It is not siar.my, the Malaysian film service, or SiAR, the Spanish irrigation API. Contact details are in the footer of every page.` },
];

const pillars = [
  { h: 'Every post accounted for', promise: 'You always know what happened to a post, and why.', body: "Each network's limits are checked when you create the post, so a bad request fails with a 400 you can fix, not at 9 a.m. Each account gets your post once. If a network says no, you get its own code and message, plus the fix. A signed webhook tells you how it went, retried for about 45 hours.", link: ['/how-publishing-works', 'How publishing works'] },
  { h: "Your customers connect through Siar's live apps, under your brand", promise: "You don't build nine sign-in flows or sit through Meta's review.", body: "Facebook, Instagram and Threads connect through Siar's Meta app, which passed Meta's App Review on 27 October 2026. X, LinkedIn profiles, Bluesky, Mastodon, Discord and Slack connect through Siar's own apps, live today. Your customers sign in through a link with your name, logo and color, and you never see a password or token.", link: ['/platforms', 'What is open on every network'] },
  { h: 'One price for the whole organization', promise: 'You pay for your organization, not for each account you connect.', body: `No per-account fees. Each brand connects one account on every open network: Starter 1 brand, Pro 10, Business unlimited. A post sent to every connected network counts as one post. ${PRICE_LOCK}`, link: ['/pricing', 'See every plan'] },
];

const reqBody = `{
  "teamId": "TEAM_ID",
  "title": "Release 2.4",
  "postDate": "2026-12-01T01:00:00.000Z",
  "status": "SCHEDULED",
  "socialAccountTypes": ["THREADS", "TWITTER", "BLUESKY", "LINKEDIN"],
  "data": {
    "THREADS":  { "text": "…512 characters…" },
    "TWITTER":  { "text": "Release 2.4 is out." },
    "BLUESKY":  { "text": "Release 2.4 is out." },
    "LINKEDIN": { "text": "Release 2.4 is out. Here is what changed and why." }
  }
}`;
const res400 = `{
  "statusCode": 400,
  "message": "Validation failed: Text is 512 characters (emoji count as their byte length); the limit is 500.",
  "issues": [
    {
      "code": "too_long",
      "message": "Text is 512 characters (emoji count as their byte length); the limit is 500.",
      "path": ["data", "THREADS", "text"]
    }
  ]
}`;
const resOk = `{ "id": "POST_ID", "status": "SCHEDULED", "postDate": "2026-12-01T01:00:00.000Z" }`;
const verbose = `"errorsVerbose": {
  "BLUESKY": {
    "code": "TOKEN_INVALID",
    "errorMessage": "Token has expired",
    "httpStatus": 400,
    "retryability": "non_retryable",
    "isTransient": false,
    "userFacingMessage": "Token has expired",
    "meta": { "error": "ExpiredToken", "message": "Token has expired" }
  }
}`;
const hook = `POST https://your-app.example/webhooks/siar
x-siar-event: post.published
x-siar-delivery: DELIVERY_ID
x-siar-timestamp: 1764550860
x-siar-signature: 5f1c…

{
  "id": "evt_…",
  "type": "post.published",
  "createdAt": "2026-12-01T01:01:00.000Z",
  "organizationId": "ORG_ID",
  "data": {
    "id": "POST_ID",
    "status": "ERROR",
    "error": "BLUESKY: Token has expired",
    "errors": { "BLUESKY": "Token has expired" },
    "externalData": {
      "THREADS":  { "status": "POSTED", "permalink": "https://www.threads.net/…" },
      "TWITTER":  { "status": "POSTED", "permalink": "https://x.com/…" },
      "LINKEDIN": { "status": "POSTED", "permalink": "https://www.linkedin.com/…" }
    }
  }
}`;

const audiences = [
  ['SaaS products', "Add social publishing to your product without building nine integrations or sitting through Meta's review. A brand per customer, one key for all of them.", '/use-cases/multi-tenant-social-media-api'],
  ['Agencies', `10 brands for ${usd('PRO')} a month (${rm('PRO')} in Malaysia). Each client connects through a link with your name and logo, and you never ask for a password.`, '/for-agencies'],
  ['AI agents', 'An agent needs to know whether its post went out: one REST call to publish, a signed webhook with the result.', '/use-cases/social-media-api-for-ai-agents'],
  ['Product and ops teams', 'Release notes to Slack, Discord, your LinkedIn profile and X in one request, on a schedule, from your CI.', '/guides/post-release-notes-from-ci'],
];

const notYet = [
  ['No track record to show yet.', 'Siar has been live since 12 October 2026, so there are no case studies or uptime record. What you can check today: the public OpenAPI file, the generated network and error references, every network\'s dated status, and a price list with a price lock.'],
  ['Some networks are still closed.', "TikTok's audit has not passed. LinkedIn company pages wait on LinkedIn granting page access. Pinterest publishing waits on Standard access. Public YouTube uploads are not yet confirmed."],
  ['The connect page is branded, not white-label.', 'It carries your name, logo and color, but it says "Powered by Siar", runs on app.siaran.my and is in English.'],
  ['One account per network per brand.', 'A client with two Instagram accounts uses two brands. Pro has 10.'],
  ['Posts are capped.', `${PLANS.STARTER.posts.toLocaleString('en-US')} a month on Starter, ${PLANS.PRO.posts.toLocaleString('en-US')} on Pro, ${PLANS.BUSINESS.posts.toLocaleString('en-US')} on Business. Drafts don't count, and retrying a failed post doesn't count again.`],
  ['No idempotency key on post creation.', 'Each network target is claimed once, but resending the create call makes a second post. Check by your own reference first.'],
  ['No npm packages yet.', 'The SDK, CLI and MCP server are built but not published. Use the REST API directly.'],
  ['No client logins, approval step or report export,', 'and the dashboard is in English.'],
];
---
<Base title="Unified social media API, every post accounted for | Siar" description={`Siar is a unified social media API: each post checked before it's sent, sent once, and its result in a signed webhook. From ${usd('STARTER')} a month (${rm('STARTER')} in Malaysia).`} jsonLd={[softwareLd({ offers: 'free' }), faqLd(faq)]}>
  <section class="m-hero">
    <div class="m-wide">
      <div class="hero-top" data-reveal>
        <p class="m-kicker def"><span class="n">siar</span> /ˈsi.ar/ <span class="rule"></span> Malay, to broadcast</p>
      </div>
      <div class="hero-main">
      <div class="hero-text">
      <h1 class="m-display" data-lines><span class="ln"><span>Write it once.</span></span> <span class="ln"><span style="--d:1">Siar it everywhere.</span></span></h1>
      <div class="hero-sub">
        <p class="m-lead pos" data-reveal style="--d:3">The unified social media API where every post is accounted for.</p>
        <p class="hero-canon" data-reveal style="--d:3">{CANONICAL}</p>
        <div class="hero-cta" data-reveal style="--d:4">
          <div class="m-actions"><a class="pill ink" href={SIGNUP_URL}>Start with {free} free posts</a><a class="pill" href="/docs/quickstart">Read the quickstart</a></div>
          <p class="note">No card. A one-time allowance, with no time limit.</p>
        </div>
      </div>
      </div>
      <div class="fan-side" data-reveal style="--d:2"><HeroFan dir="side" /></div>
      </div>
      <div class="fan-down" data-reveal style="--d:5"><HeroFan dir="down" /></div>
    </div>
    <div class="m-wide stage-wrap">
      <div class="stage" data-reveal style="--d:5">
        <figure class="frame main">
          <div class="frame-bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">app.siaran.my/posts</span></div>
          <picture>
            <source media="(max-width: 760px)" srcset="/shots/posts-phone.webp" width="780" height="1688" />
            <img class="lt" src="/shots/posts.webp" width="3072" height="1728" alt="The Siar dashboard: a brand's posts, scheduled and drafted across networks" fetchpriority="high" />
          </picture>
          <img class="dk" src="/shots/posts-dark.webp" width="3072" height="1728" alt="" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <section class="m-sec pillars">
    <div class="m-wide">
      <h2 class="m-h2" data-reveal>What changes when your posts go through Siar</h2>
      <div class="p3">
        {pillars.map((p, i) => (
          <div class="pl" data-reveal style={`--d:${i}`}>
            <h3>{p.h}</h3>
            <p class="promise">{p.promise}</p>
            <p>{p.body}</p>
            <a class="tl" href={p.link[0]}>{p.link[1]}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="m-sec example" id="example">
    <div class="m-wide">
      <div class="ex-head">
        <p class="m-kicker" data-reveal><span class="n">Example</span></p>
        <h2 class="m-h2" data-reveal>What happens to a post, start to finish</h2>
        <p class="m-lead" data-reveal>One post to Threads, X, Bluesky and a LinkedIn profile, from first request to final webhook. The IDs, dates and text are made up. The shapes, fields and messages are the ones the API returns.</p>
      </div>
      <ol class="steps">
        <li>
          <div class="st"><h3>The request is checked before anything is scheduled</h3><p>The Threads text is too long. Siar answers at once with a <code>400</code> that points at the field. Nothing is created and nothing counts against your plan.</p></div>
          <div class="sc"><CodeBlock lang="http" code={'POST /api/v1/post\nx-api-key: sk_live_…'} /><CodeBlock lang="json" code={reqBody} /><CodeBlock lang="json" code={res400} /></div>
        </li>
        <li>
          <div class="st"><h3>Fixed, scheduled, sent once</h3><p>Shorten the Threads line and send it again. The post is scheduled. At publish time each network target is claimed once, so a retry, a restart or a double click cannot publish it twice.</p></div>
          <div class="sc"><CodeBlock lang="json" code={resOk} /></div>
        </li>
        <li>
          <div class="st"><h3>One network says no, in its own words</h3><p>Threads, X and LinkedIn publish. Bluesky refuses, because the account's session has expired. Siar keeps Bluesky's own code and message on the post, marks the account for reconnecting and sends a <code>social-account.updated</code> webhook. The fix, from Siar's error reference: reconnect the Bluesky account.</p><a class="tl" href="/bluesky-api/errors">Bluesky API error codes</a></div>
          <div class="sc"><CodeBlock lang="json" code={verbose} /></div>
        </li>
        <li>
          <div class="st"><h3>Your server hears the result, signed</h3><p><code>post.published</code> fires when the whole post has published or failed. It carries each network's result. It is signed with HMAC-SHA256. If your server doesn't answer, it is retried 7 times over about 45 hours.</p></div>
          <div class="sc"><CodeBlock lang="http" code={hook} /></div>
        </li>
        <li>
          <div class="st"><h3>Retry sends only what failed</h3><p>Once the account is reconnected, retry the post. Only Bluesky is sent again, and the retry doesn't use another post from your plan.</p></div>
          <div class="sc"><CodeBlock lang="http" code="POST /api/v1/post/POST_ID/retry" /></div>
        </li>
      </ol>
      <p class="ex-close" data-reveal>The post's status is <code>ERROR</code> because one network failed. Each network's own result sits beside it. That is what "accounted for" means: posted, failed with the network's reason, or "could not be confirmed" when an interrupted send can't be checked. Siar promises that you'll know which. It can't promise that every network will say yes. <a href="/how-publishing-works">How publishing works</a></p>
    </div>
  </section>

  <section class="m-sec nets">
    <div class="m-wide">
      <div class="nets-head">
        <h2 class="m-h2" data-reveal>Post once, publish everywhere Siar is open</h2>
        <div data-reveal>
          <p class="m-lead">Siar is built for {N} networks. Publish to {OPEN_LIST} today. TikTok, YouTube (public uploads), Pinterest publishing, LinkedIn company pages, Reddit, Snapchat and Google Business Profile are built and open as each network approves Siar.</p>
          <p class="nets-2">One request carries a block per network, so each one keeps what makes it different: an Instagram reel, a thread on X, a Mastodon content warning, a Discord message with your bot's name. Each network's rules are checked before anything leaves.</p>
        </div>
      </div>
      <ul class="grid15">
        {tiles.map((n, i) => {
          const s = NETWORK_STATUS[n.type];
          const open = s.status === 'open' || s.status === 'partial';
          return (
            <li data-reveal style={`--d:${i % 5}`} class:list={[{ closed: !open }]}>
              <a href={`/${n.apiSlug}`}>
                <NetIcon type={n.type} size={44} />
                <span class="nm">{n.name}</span>
                <span class="ln2">{s.line}</span>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="more-l" data-reveal><a class="pill" href="/platforms">Every network's status, with dates</a></p>
    </div>
  </section>

  <section class="m-sec tour" id="tour">
    <div class="m-wide">
      <div class="sec-head">
        <h2 class="m-h2" data-reveal>A social media management API, with the dashboard built on it</h2>
        <p class="m-lead" data-reveal>The dashboard is a client of the same API you get. Your team writes, schedules, replies and reports there. Your code does the same over REST.</p>
      </div>
      <Flow />
      <p class="tour-more" data-reveal><a class="pill" href="/features">Take the product tour</a></p>
    </div>
  </section>

  <section class="m-sec m-ink price">
    <div class="m-wide price-grid">
      <div>
        <h2 class="m-h2" data-reveal>One price for your organization, not for each account</h2>
        <p class="m-lead" data-reveal>{usd('STARTER')} a month ({rm('STARTER')} in Malaysia); unlimited brands on Business, {usd('BUSINESS')} ({rm('BUSINESS')}). Every plan connects unlimited social accounts, and a post sent to every connected network counts as one post.</p>
        <p class="pbody" data-reveal>Plans are fenced by brands and posts. Starter is 1 brand and {PLANS.STARTER.posts.toLocaleString('en-US')} posts a month. Pro is 10 brands and {PLANS.PRO.posts.toLocaleString('en-US')} posts, with a 14-day trial. Business is unlimited brands and {PLANS.BUSINESS.posts.toLocaleString('en-US')} posts. A brand is a team in the API, and each brand connects one account on every open network. Yearly is 10 times monthly, so 2 months are free. {PRICE_LOCK}</p>
        <p class="pbody" data-reveal>Ringgit for organizations billed in Malaysia: card monthly, or pay a year once by FPX or DuitNow. US dollars by card everywhere else.</p>
        <p class="trust" data-reveal>Who you pay: {LEGAL_NAME} (SSM {LEGAL_REG}), Malaysia. Siar's Meta app passed App Review on 27 October 2026.</p>
        <p class="price-link" data-reveal><a class="pill" href="/pricing">See every plan</a></p>
      </div>
      <div data-reveal style="--d:2"><PriceCalc /></div>
    </div>
  </section>

  <section class="m-sec dev">
    <div class="m-wide dev-grid">
      <div class="dev-copy">
        <h2 class="m-h2" data-reveal>Your first post is one request away.</h2>
        <ol class="three" data-reveal>
          <li><p><strong>Create a key</strong> in the dashboard. It works for every brand in your organization.</p></li>
          <li><p><strong>Connect an account</strong> yourself, or send your customer a branded connect link.</p></li>
          <li><p><strong>Send one request</strong> with a block per network. One signed webhook reports each network's result.</p></li>
        </ol>
        <p class="dev-note" data-reveal>One REST API, described by a public OpenAPI 3.0 file ({OP_COUNT()} operations). The TypeScript SDK, CLI and MCP server (version 0.1.0) are built from the same OpenAPI contract and are not on npm yet. Today, call the API with curl, fetch or requests.</p>
        <p class="dev-links" data-reveal><a href="/docs/quickstart">Read the quickstart</a><a href="/openapi.json">OpenAPI file</a><a href="/docs/webhooks">Webhooks guide</a></p>
      </div>
      <div class="dev-code" data-reveal style="--d:2"><p class="ex-label">Example</p><CodeTabs tabs={postTabs()} /></div>
    </div>
  </section>

  <section class="m-sec for">
    <div class="m-wide">
      <h2 class="m-h2" data-reveal>Built for people who post for a living.</h2>
      <div class="m-rows">
        {audiences.map(([t, d, href]) => <a class="m-row aud" href={href} data-reveal><span class="t">{t}</span><p class="d">{d}</p></a>)}
      </div>
    </div>
  </section>

  <section class="m-sec notyet">
    <div class="m-wide ny-grid">
      <div>
        <h2 class="m-h2" data-reveal>What Siar doesn't do yet</h2>
        <p class="m-lead" data-reveal>Better you read it here than find it after you've built on it.</p>
        <p data-reveal><a class="pill" href="/platforms">Every network's status, with dates</a></p>
      </div>
      <ul class="ny">{notYet.map(([b, t]) => <li data-reveal><strong>{b}</strong> {t}</li>)}</ul>
    </div>
  </section>

  <section class="m-sec faqs">
    <div class="m-wide faq-grid">
      <h2 class="m-h3" data-reveal>Questions, answered straight</h2>
      <Faq items={faq} title="" />
    </div>
  </section>
</Base>
<style>
  .m-hero { padding: clamp(32px, 6vw, 80px) 0 0; overflow: hidden; }
  .hero-top { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .hero-top .m-kicker { margin-bottom: clamp(20px, 3vw, 36px); }
  .m-hero h1 { max-width: 11.5em; }
  .m-hero h1 .ln { display: block; }
  .hero-sub { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; margin-top: clamp(28px, 4vw, 48px); max-width: 720px; }
  .pos { color: var(--text); font-weight: 500; }
  .hero-canon { margin: 0; font-size: var(--fs-15); line-height: 24px; color: var(--text-muted); }
  .hero-cta { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  .note { margin: 0; font-size: var(--fs-14); line-height: 20px; color: var(--text-subtle); }
  .hero-main { display: grid; grid-template-columns: minmax(0, 1fr) clamp(250px, 21vw, 300px); column-gap: clamp(48px, 6vw, 96px); align-items: center; }
  .hero-main h1 { font-size: clamp(56px, 8.2vw, 110px); }
  .fan-side :global(.fan) { width: 100%; }
  .fan-down { display: none; }
  @media (max-width: 1060px) {
    .hero-main { display: block; }
    .hero-main h1 { font-size: var(--display); }
    .fan-side { display: none; }
    .fan-down { display: block; max-width: 440px; margin: 48px auto 0; }
  }

  .stage-wrap { margin-top: clamp(48px, 7vw, 96px); }
  .main img { aspect-ratio: 16 / 9; }
  .main .dk { display: none; }
  :global(:root[data-theme='dark']) .main .dk { display: block; }
  :global(:root[data-theme='dark']) .main .lt { display: none; }
  @media (max-width: 760px) {
    .stage { display: flex; justify-content: center; }
    .main { width: 100%; max-width: 360px; border-radius: 28px; }
    .main .frame-bar { display: none; }
    .main img { aspect-ratio: 390 / 600; object-fit: cover; object-position: top; }
    :global(:root[data-theme='dark']) .main .lt { display: block; }
    :global(:root[data-theme='dark']) .main .dk { display: none; }
  }

