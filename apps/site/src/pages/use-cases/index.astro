---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { USE_CASES } from '../../lib/usecases';
---
<Base title="Use cases" description="What teams build with the Siar social media API: posting, scheduling, multi-tenant products, analytics, comments, webhooks, hosted connect and AI agents.">
  <section class="section tight">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Use cases</p><h1>What you can build with Siar</h1><p class="lead">Each page shows the requests, the limits and the questions that come up for one job.</p></div>
      <div class="grid g2">
        {USE_CASES.map((u) => <a class="card" href={`/use-cases/${u.slug}`}><h3>{u.title}</h3><p>{u.description}</p><span class="more">Read more</span></a>)}
      </div>
    </div>
  </section>
  <Cta />
</Base>
