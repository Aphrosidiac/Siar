---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import NetworkGrid from '../../components/NetworkGrid.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { USE_CASES, type UseCase } from '../../lib/usecases';
import { faqLd, breadcrumbLd } from '../../lib/seo';
import { SIGNUP_URL } from '../../config';
export function getStaticPaths() {
  return USE_CASES.map((u) => ({ params: { slug: u.slug }, props: { u } }));
}
const { u } = Astro.props as { u: UseCase };
---
<Base title={u.title} description={u.description} jsonLd={[faqLd(u.faq), breadcrumbLd([{ name: 'Use cases', href: '/use-cases' }, { name: u.title, href: `/use-cases/${u.slug}` }])]}>
  <PageHero kicker="Use cases" note={u.nav} title={u.h1} lead={u.lead}>
    <div class="m-actions"><a class="pill ink" href={SIGNUP_URL}>Start free <span class="arr" aria-hidden="true">→</span></a><a class="pill" href="/docs/quickstart">Quickstart</a></div>
  </PageHero>
  <section class="section tight">
    <div class="container body">
      <ul class="ticks">{u.points.map((p) => <li set:html={p} />)}</ul>
      {u.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          {s.p.map((p) => <p set:html={p} />)}
          {s.code && <CodeBlock code={s.code.code} lang={s.code.lang} />}
        </>
      ))}
      <h2>Works with {'every'} supported network</h2>
      <NetworkGrid showTypes={false} />
      <div class="faqw"><Faq items={u.faq} /></div>
      <h3>Keep reading</h3>
      <ul>{u.related.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
    </div>
  </section>
  <Cta />
</Base>
<style>
  .head { max-width: 820px; }
  .body > :global(*) { max-width: 860px; }
  .body h2 { margin-top: 44px; }
  .faqw { margin: 48px 0 24px; }
  .ticks { list-style: none; padding: 0; margin: 0 0 8px; border-top: 1px solid var(--border); }
  .ticks li { padding: 12px 0; margin: 0; border-bottom: 1px solid var(--border); font-size: var(--fs-16); line-height: 24px; }
</style>
