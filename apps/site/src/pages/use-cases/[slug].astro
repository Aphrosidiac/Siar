---
import Article from '../../layouts/Article.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Faq from '../../components/Faq.astro';
import NetworkTable from '../../components/usecases/NetworkTable.astro';
import UseCaseCta from '../../components/usecases/UseCaseCta.astro';
import { USE_CASES, type UseCase } from '../../lib/usecases';
import { updatedAt } from '../../lib/updated.mjs';

export function getStaticPaths() {
  return USE_CASES.map((u) => ({ params: { slug: u.slug }, props: { u } }));
}
const { u } = Astro.props as { u: UseCase };
const path = `/use-cases/${u.slug}`;
// The later of the page's own checked date and the last commit that touched it, so a commit never shows an older date.
const git = updatedAt(path);
const updated = git && git > u.updated ? git : u.updated;
const crumbs = [{ name: 'Use cases', href: '/use-cases' }, { name: u.nav, href: path }];
---
<Article metaTitle={u.title} h1={u.h1} description={u.description} kicker="Use case" updated={updated} crumbs={crumbs} lead={u.lead} actions="signup" cta={false}>
  <ul class="ticks">{u.points.map((p) => <li set:html={p} />)}</ul>
  {u.sections.map((s) => (
    <>
      <h2 id={s.id}>{s.h}</h2>
      {s.p.map((p) => <p set:html={p} />)}
      {s.list && <ul>{s.list.map((l) => <li set:html={l} />)}</ul>}
      {s.table && (
        <div class="table-wrap">
          <table>
            {s.table.caption && <caption class="small">{s.table.caption}</caption>}
            <thead><tr>{s.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{s.table.rows.map((r) => <tr>{r.map((c) => <td set:html={c} />)}</tr>)}</tbody>
          </table>
        </div>
      )}
      {s.code && <CodeBlock code={s.code.code} lang={s.code.lang} title={s.code.title} />}
      {s.after?.map((p) => <p set:html={p} />)}
    </>
  ))}
  {u.networks && <NetworkTable mode={u.networks} />}
  <h2 id="not-yet">What this doesn't cover yet</h2>
  <ul>{u.limits.map((l) => <li set:html={l} />)}</ul>
  <h2 id="keep-reading">Keep reading</h2>
  <ul>
    {u.related.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
    <li><a href="/use-cases">More social media API use cases</a></li>
  </ul>
  <div class="faqw"><Faq items={u.faq} /></div>
  <UseCaseCta />
</Article>
<style>
  .ticks { list-style: none; padding: 0; margin: 0 0 8px; border-top: 1px solid var(--border); }
  .ticks li { padding: 12px 0; margin: 0; border-bottom: 1px solid var(--border); font-size: var(--fs-16); line-height: 24px; }
  .faqw { margin-top: 56px; }
  caption { caption-side: bottom; text-align: left; padding: 10px 16px; }
</style>
