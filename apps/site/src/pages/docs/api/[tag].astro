---
import Doc from '../../../layouts/Doc.astro';
import OpList from '../../../components/OpList.astro';
import { tagsInOrder, tagMeta, opsForTag, miscGroups, miscGroup } from '../../../lib/openapi';
import { NETWORKS } from '../../../lib/networks';
export function getStaticPaths() {
  return tagsInOrder().map((tag) => ({ params: { tag: tagMeta(tag).slug }, props: { tag } }));
}
const { tag } = Astro.props;
const m = tagMeta(tag);
const ops = opsForTag(tag);
const isMisc = m.slug === 'misc';
const netName = (seg: string) => NETWORKS.find((x) => x.misc === seg)?.name ?? seg;
const groups = isMisc ? miscGroups().map((seg) => ({ slug: seg, name: netName(seg), count: ops.filter((o) => miscGroup(o) === seg).length })) : [];
/** Titles 25–60 and descriptions 120–160 characters (docs/seo/ACCEPTANCE.md), built from the tag. */
const metaTitle = `${m.title} API reference · Siar social media API`;
const n = `${ops.length} ${ops.length === 1 ? 'operation' : 'operations'}`;
const fit = (xs: string[]) => xs.find((x) => x.length >= 120 && x.length <= 160) ?? xs[0];
const description = fit([
  `${m.title} in the Siar social media API: ${n} with parameters, request body fields, responses and curl examples, generated from the OpenAPI file.`,
  `${m.title} in the Siar social media API: ${n} with parameters, body fields, responses and curl examples, generated from the OpenAPI file.`,
  `${m.title}: ${n} in the Siar social media API, with parameters, body fields and curl examples, from the OpenAPI file.`,
]);
---
<Doc title={`${m.title} API`} metaTitle={metaTitle} description={description} nav="api" toc={false}>
  {isMisc ? (
    <>
      <h2>Network-specific operations, by network</h2>
      <div class="table-wrap"><table>
        <thead><tr><th>Network</th><th>Operations</th></tr></thead>
        <tbody>{groups.map((g) => <tr><td><a href={`/docs/api/misc/${g.slug}`}>{g.name} endpoints</a></td><td>{g.count}</td></tr>)}</tbody>
      </table></div>
    </>
  ) : <OpList ops={ops} />}
</Doc>
