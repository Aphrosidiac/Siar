---
/**
 * The social share card, 1200×630. Not a page for people: scripts/og.mjs screenshots it to
 * public/og.png. Kept out of the sitemap and search.
 */
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import HeroFan from '../components/home/HeroFan.astro';
import { NETWORKS } from '../lib/networks';
import { SITE_URL } from '../config';
const host = new URL(SITE_URL).host;
---
<Base title="Share card" noindex bare>
  <div class="card">
    <div class="left">
      <Logo size={34} class="lg" />
      <h1>Write it once.<br />Siar it everywhere.</h1>
      <p class="lead">One API and one dashboard to publish, schedule, reply and measure on {NETWORKS.length} social networks.</p>
      <p class="foot"><span>{host}</span><span class="dot">·</span>Unified social media API</p>
    </div>
    <div class="right"><HeroFan dir="side" /></div>
  </div>
</Base>
<style>
  :global(html), :global(body) { margin: 0; background: #f3efe4; }
  .card { width: 1200px; height: 630px; box-sizing: border-box; padding: 64px 72px; display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 56px; align-items: center; background: #f3efe4; color: #0b0b0a; overflow: hidden; }
  .left { display: flex; flex-direction: column; height: 100%; }
  .card :global(.lg .wm) { font-size: 30px; }
  .card :global(.lg) { gap: 12px; }
  h1 { margin: auto 0 0; font-size: 84px; line-height: .95; letter-spacing: -0.055em; font-weight: 600; }
  .lead { margin: 28px 0 auto; max-width: 600px; font-size: 25px; line-height: 1.4; color: #4a4843; }
  .foot { margin: 0; font-family: var(--mono); font-size: 18px; letter-spacing: .02em; color: #6f6c64; display: flex; gap: 12px; }
  .foot span:first-child { color: #0b0b0a; font-weight: 500; }
  .right :global(.fan) { width: 100%; }
  /* the share card is a still: every network mark shown lit, no pulses */
  .right :global(.pulses) { display: none; }
  .right :global(.tile rect) { animation: none; fill: #0b0b0a; stroke: #0b0b0a; }
  .right :global(.tile path) { animation: none; fill: #f3efe4; }
  .right :global(.lines path) { stroke: #b9b4a6; }
</style>
