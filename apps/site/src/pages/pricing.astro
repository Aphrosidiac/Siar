---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlanCards from '../components/PlanCards.astro';
import PricingTables from '../components/PricingTables.astro';
import QuotaRules from '../components/QuotaRules.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { PLANS, TRIAL_DAYS, TRIAL_TIER, PRICE_LOCK, INBOX_NOTE, X_CREDIT_NOTE, paidFrom, paidList, fmtMicro, X_PRICES } from '../lib/plans';
import { NETWORKS } from '../lib/networks';
import { SIGNUP_URL } from '../config';
import { faqLd, breadcrumbLd, softwareLd } from '../lib/seo';

const N = NETWORKS.length;
const claims = [
  { h: 'Pay by business, not by channel.', p: 'Every plan connects unlimited social accounts. You pay for the brands you run, never per channel.' },
  { h: 'One post counts once.', p: "A post that goes to every network you've connected counts as one post on your plan." },
  { h: 'Priced for Malaysia.', p: `Organizations billed in Malaysia pay in ringgit, by card or, yearly, once with FPX or GrabPay. Everywhere else: ${paidList('usd').replace(/ \/ /g, ', ').replace(/, ([^,]*)$/, ' and $1')} a month by card.` },
];
const faq = [
  { q: 'Why is pricing by brand and not by account?', a: 'What costs us money is the work your organization does (posts published, comments, uploads), not the number of accounts that exist. So every plan connects unlimited social accounts, and the plans differ in the brands you can run and the posts, comments and uploads you create.' },
  { q: 'What counts as a post?', a: `A post counts once, no matter how many networks it targets. On paid plans it counts in the UTC month you create it or move it out of draft. On Free it counts against the one-time allowance of ${PLANS.FREE.posts} posts. Drafts are free and retries of a failed post do not count again.` },
  { q: 'What happens at my quota?', a: 'Creating or scheduling another post returns a 403 that names the limit. Anything already scheduled still publishes: quotas are checked once, when you create the post. The Free allowance never resets, so when it is used up, choose a paid plan to carry on.' },
  { q: 'How do I pay?', a: 'Organizations billed in Malaysia pay in ringgit by card or, for a year at a time, once with FPX or GrabPay. Everywhere else pays in US dollars by card.' },
  { q: 'Is there a free trial?', a: `Yes, ${TRIAL_DAYS} days on ${PLANS[TRIAL_TIER].name}. The Free plan is separate: ${PLANS.FREE.posts} posts to try, no card and no time limit.` },
  { q: 'Is the inbox included?', a: `Direct messages and comment-to-DM automations have allowances on every paid plan. They are for ${INBOX_NOTE}.` },
  { q: 'Why do daily caps exist?', a: 'Networks throttle or flag accounts that publish too often. Caps keep a single account inside what each network tolerates. They follow the underlying network identity, so reconnecting an account does not reset them. Enterprise organizations can have them raised.' },
  { q: 'How does X (Twitter) billing work?', a: `X charges per API call, so X actions are paid from a prepaid credit balance at X's own price in USD, with no markup from us. ${X_CREDIT_NOTE} Publishing a post costs ${fmtMicro(X_PRICES.TWITTER_CONTENT_CREATE)}; a post containing a link costs ${fmtMicro(X_PRICES.TWITTER_CONTENT_CREATE_WITH_URL)}. If the balance runs out, only X actions fail.` },
  { q: 'Can I change plan or cancel?', a: `Yes, from the dashboard billing page. ${PRICE_LOCK} Paid quotas are per calendar month, so a change applies from the moment it takes effect.` },
  { q: 'What does Enterprise add?', a: 'Higher quotas, daily caps and rate limits set per organization, and a quoted price. Contact us with your volumes.' },
];
---
<Base title="Pricing: pay by business, not by channel" description={`Siar pricing: Free with ${PLANS.FREE.posts} posts to try, paid plans from ${paidFrom('myr')} a month in Malaysia and ${paidFrom('usd')} elsewhere. Unlimited social accounts on every plan. X usage passed through at cost.`} jsonLd={[softwareLd(), faqLd(faq), breadcrumbLd([{ name: 'Pricing', href: '/pricing' }])]}>
  <PageHero kicker="Pricing" note="per organization" title="One price per business." dim="Every account included." lead={`Plans are per organization. Every plan connects unlimited social accounts across all ${N} networks. A plain-text version of this page is at <a href="/pricing.md">/pricing.md</a>.`} />
  <section class="section tight">
    <div class="container">
      <div class="claims">
        {claims.map((c) => <div><h2>{c.h}</h2><p>{c.p}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section tight">
    <div class="container">
      <PlanCards />
      <p class="pricing-note">{PRICE_LOCK}</p>
      <p class="pricing-note">Building on the API? <a href={SIGNUP_URL}>Start the {TRIAL_DAYS}-day Pro trial.</a></p>
      <p class="pricing-note muted">Inbox and comment-to-DM: {INBOX_NOTE}.</p>
    </div>
  </section>
  <section class="section alt">
    <div class="container prose-wide">
      <h2>How quotas work</h2>
      <QuotaRules />
    </div>
  </section>
  <section class="section">
    <div class="container prose-wide">
      <h2>Quotas and limits by plan</h2>
      <p>Every figure below is read from the same constants the API enforces. The Free plan is a one-time allowance; paid plans count per month.</p>
      <PricingTables show={['prices', 'quotas', 'imports', 'messaging', 'resources']} />
    </div>
  </section>
  <section class="section alt">
    <div class="container prose-wide">
      <h2>Per-network daily caps</h2>
      <PricingTables show={['caps', 'comments', 'length']} />
    </div>
  </section>
  <section class="section" id="x">
    <div class="container prose-wide">
      <h2>X (Twitter): prepaid credit at X's prices</h2>
      <PricingTables show={['x']} heading={false} />
      <p class="small">Top up the balance from the dashboard. Balance changes use a ledger (hold, then capture or release) so a failed publish never charges you. Webhooks fire at <code>credit.low-balance</code> and <code>credit.exhausted</code>; quote an action before running it with the credit endpoints in the <a href="/docs/api/credit">API reference</a>.</p>
    </div>
  </section>
  <section class="section alt">
    <div class="container prose-wide"><Faq items={faq} /></div>
  </section>
  <Cta />
</Base>
<style>
  .prose-wide { max-width: 960px; }
  .hd { max-width: 820px; }
  .claims { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 40px; margin: 0 0 40px; }
  .claims > div { border-top: 1px solid var(--text); padding-top: 16px; }
  .claims h2 { font-size: var(--fs-18); line-height: 26px; letter-spacing: -0.02em; margin: 0 0 6px; }
  .claims p { margin: 0; font-size: var(--fs-15); line-height: 24px; color: var(--text-muted); }
  @media (max-width: 800px) { .claims { grid-template-columns: minmax(0, 1fr); gap: 20px; margin-bottom: 32px; } }
  .pricing-note { margin: 16px 0 0; font-size: var(--fs-15); line-height: 24px; color: var(--text); }
  .pricing-note.muted { font-size: var(--fs-13); line-height: 20px; color: var(--text-subtle); }
  .pricing-note a { text-decoration: underline; text-underline-offset: 3px; }
</style>
