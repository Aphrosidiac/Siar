---
/**
 * The product walkthrough as a demo player: five steps, each a short screen recording of the real
 * dashboard (scripts/clips.mjs). The active clip plays once and the next step starts when it ends;
 * the step's progress line follows the clip. Click a step to jump; while a mouse is over it, it plays but does not move on.
 * Phones get the same player: the step text above the whole, uncropped recording.
 * Reduced motion: posters only, no autoplay.
 */
interface Step { n: string; tag: string; short: string; title: string; body: string; clip: string; url: string }
const steps: Step[] = [
  { n: '01', tag: 'Connect', short: 'Connect', title: 'Customers connect their own accounts.', body: 'Send a hosted link with your name on it. They sign in to each network themselves and land back in your app. You never touch a password or a token.', clip: 'connect', url: 'app.siaran.my/connect' },
  { n: '02', tag: 'Write once', short: 'Write', title: 'One post, every network.', body: 'Pick the accounts and write it once. Every network\'s character limit updates as you type.', clip: 'write', url: 'app.siaran.my/compose' },
  { n: '03', tag: 'Tailor', short: 'Tailor', title: 'Then make each one fit.', body: 'Give Threads a shorter line, Instagram a first comment, Pinterest a board. Each network\'s own fields, checked before anything is sent.', clip: 'tailor', url: 'app.siaran.my/compose' },
  { n: '04', tag: 'Schedule', short: 'Schedule', title: 'Schedule it and move on.', body: 'Siar publishes on time in your timezone, retries what a network bounces, and shows you each network\'s result.', clip: 'schedule', url: 'app.siaran.my/posts' },
  { n: '05', tag: 'Measure', short: 'Measure', title: 'See what landed.', body: 'Followers, reach and engagement for every network on one screen, with comments and DMs in a shared inbox.', clip: 'measure', url: 'app.siaran.my/analytics' },
];
const src = (s: Step) => `/clips/${s.clip}.mp4`;
const poster = (s: Step) => `/clips/${s.clip}.webp`;
---
<div class="player" data-player>
  <div class="tabs" role="tablist" aria-label="Walkthrough steps">
    {steps.map((s, i) => (
      <button type="button" role="tab" id={`pt-${i}`} aria-controls="pp" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
        <span class="bar"><i></i></span>
        <span class="lbl"><span class="n">{s.n}</span><span class="full">{s.tag}</span><span class="short">{s.short}</span></span>
      </button>
    ))}
  </div>
  <div class="panel" id="pp" role="tabpanel">
    <div class="copy">
      {steps.map((s, i) => (
        <div class:list={['txt', { on: i === 0 }]} data-txt={i}>
          <p class="step"><span>{s.n}</span> / 05</p>
          <h3 class="m-h3">{s.title}</h3>
          <p class="body">{s.body}</p>
        </div>
      ))}
    </div>
    <figure class="frame win">
      <div class="frame-bar"><span class="dots"><i></i><i></i><i></i></span><span class="url" data-url>{steps[0].url}</span></div>
      <div class="view">
        {steps.map((s, i) => (
          <video class:list={[{ on: i === 0 }]} data-clip={i} data-url={s.url} poster={poster(s)} muted playsinline preload={i === 0 ? 'auto' : 'metadata'} aria-label={`${s.tag}: a recording of the Siar dashboard`}>
            <source src={src(s)} type="video/mp4" />
          </video>
        ))}
      </div>
    </figure>
  </div>
</div>
<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const txts = [...root.querySelectorAll<HTMLElement>('[data-txt]')];
    const clips = [...root.querySelectorAll<HTMLVideoElement>('[data-clip]')];
    const url = root.querySelector<HTMLElement>('[data-url]')!;
    let cur = 0, visible = false, held = false, raf = 0, next = 0;
    const running = () => visible && !still;
    // the active tab's line follows the clip
    const tick = () => {
      const v = clips[cur];
      const p = v.duration ? Math.min(1, v.currentTime / v.duration) : 0;
      tabs[cur].style.setProperty('--p', String(p));
      raf = requestAnimationFrame(tick);
    };
    const show = (i: number) => {
      cur = (i + tabs.length) % tabs.length;
      clearTimeout(next);
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === cur)); t.classList.toggle('done', k < cur); t.style.setProperty('--p', k < cur ? '1' : '0'); });
      txts.forEach((t, k) => t.classList.toggle('on', k === cur));
      clips.forEach((v, k) => { v.classList.toggle('on', k === cur); if (k !== cur) v.pause(); });
      url.textContent = clips[cur].dataset.url ?? '';
      const v = clips[cur];
      v.currentTime = 0;
      if (running()) v.play().catch(() => {});
      // warm the next clip
      const n = clips[(cur + 1) % clips.length]; if (n.preload !== 'auto') { n.preload = 'auto'; n.load(); }
    };
    const advance = () => { if (running() && !held) { show(cur + 1); sync(); } };
    clips.forEach((v, k) => v.addEventListener('ended', () => { if (k === cur) next = window.setTimeout(advance, 500); }));
    const sync = () => {
      cancelAnimationFrame(raf);
      const v = clips[cur];
      if (running()) { if (v.ended) { if (!held) { show(cur + 1); clips[cur].play().catch(() => {}); } } else v.play().catch(() => {}); raf = requestAnimationFrame(tick); }
      else { v.pause(); clearTimeout(next); }
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => { show(i); sync(); }));
    root.querySelector('.tabs')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k !== 'ArrowRight' && k !== 'ArrowLeft') return;
      show(cur + (k === 'ArrowRight' ? 1 : -1)); tabs[cur].focus(); sync();
    });
    // only a mouse holds the step: a tap fires pointerenter with no pointerleave to follow
    root.querySelector('.panel')!.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') held = true; });
    root.querySelector('.panel')!.addEventListener('pointerleave', () => { if (!held) return; held = false; if (clips[cur].ended) advance(); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.35 }).observe(root);
    show(0);
  });
</script>
<style>
  .tabs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin-bottom: clamp(28px, 3.5vw, 44px); }
  .tabs button { display: flex; flex-direction: column; gap: 12px; padding: 0 0 4px; border: 0; background: none; font: inherit; text-align: left; cursor: pointer; color: var(--text-faint); transition: color 300ms; }
  .tabs button:hover, .tabs button[aria-selected='true'], .tabs button.done { color: var(--text); }
  .bar { position: relative; height: 2px; border-radius: 2px; background: var(--border); overflow: hidden; }
  .bar i { position: absolute; inset: 0; background: var(--text); transform: scaleX(var(--p, 0)); transform-origin: left; }
  .lbl { display: flex; gap: 10px; font-family: var(--mono); font-size: var(--fs-12); line-height: 16px; letter-spacing: .06em; text-transform: uppercase; }
  .lbl .n { color: var(--text-subtle); }
  .lbl .short { display: none; }
  .panel { display: grid; grid-template-columns: minmax(0, 0.5fr) minmax(0, 1.5fr); gap: clamp(32px, 4.5vw, 64px); align-items: center; }
  .copy { display: grid; }
  .txt { grid-area: 1 / 1; opacity: 0; transform: translateY(10px); transition: opacity 250ms, transform 450ms var(--ease-out); visibility: hidden; }
  .txt.on { opacity: 1; transform: none; visibility: visible; transition-delay: 80ms; }
  .step { font-family: var(--mono); font-size: var(--fs-12); line-height: 16px; letter-spacing: .06em; color: var(--text-faint); margin: 0 0 20px; }
  .step span { color: var(--text); }
  .copy .m-h3 { font-size: clamp(26px, 2.5vw, 36px); }
  .body { font-size: var(--fs-16); line-height: 26px; color: var(--text-muted); margin: 0; }
  .view { position: relative; aspect-ratio: 16 / 10; background: var(--bg); }
  .view video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 300ms; }
  .view video.on { opacity: 1; }
  @media (max-width: 860px) {
    .tabs { gap: 8px; margin-bottom: 24px; }
    .tabs button { gap: 10px; }
    .lbl { flex-direction: column; gap: 2px; font-size: var(--fs-11); letter-spacing: .04em; }
    .lbl .full { display: none; }
    .lbl .short { display: inline; }
    .panel { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .step { margin-bottom: 12px; }
    .copy .m-h3 { font-size: 26px; }
    .body { font-size: var(--fs-15); line-height: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .txt, .view video { transition: none; } }
</style>
