---
/**
 * The product walkthrough as a small demo player: five step tabs, the active step's words on the left
 * and its screenshot on the right. Advances by itself while on screen (paused on hover or reduced
 * motion); click a step to jump. Phones get the steps stacked, each with its own shot.
 * Shots come from scripts/shots.mjs (the dashboard with the demo seed).
 */
interface Step { crop: [number, number, number]; n: string; tag: string; title: string; body: string; img: string; url: string }
const steps: Step[] = [
  { n: '01', tag: 'Connect', title: 'Your customers connect their own accounts.', body: 'Send a hosted link with your name on it. They sign in to each network in their own browser and land back in your app. You never see a password or a token.', crop: [0.5, 0.3, 1.9], img: 'portal', url: 'app.siar.dev/connect' },
  { n: '02', tag: 'Write once', title: 'One post. Every network.', body: 'Pick the accounts and write it once. The character limit for every network updates as you type, so nothing gets cut off.', crop: [0.38, 0.38, 1.6], img: 'flow-2', url: 'app.siar.dev/compose' },
  { n: '03', tag: 'Tailor', title: 'Then make each one fit.', body: 'Give Threads a shorter line, add a first comment on Instagram, pick a board on Pinterest. Every network keeps its own fields, checked before anything is sent.', crop: [0.42, 0.45, 1.7], img: 'flow-3', url: 'app.siar.dev/compose' },
  { n: '04', tag: 'Schedule', title: 'Schedule it and move on.', body: 'Siar publishes on time in your timezone, retries what a network bounces, and shows what happened on each network.', crop: [0.8, 0.4, 1.7], img: 'flow-4', url: 'app.siar.dev/posts' },
  { n: '05', tag: 'Measure', title: 'See what landed.', body: 'Followers, reach and engagement per network on one screen, with every comment and DM in a shared inbox beside it.', crop: [0.55, 0.32, 1.6], img: 'analytics', url: 'app.siar.dev/analytics' },
];
const shot = (s: Step) => `/shots/${s.img}.webp`;
const STEP_MS = 6500;
---
<div class="player" data-player data-ms={STEP_MS} style={`--ms:${STEP_MS}ms`}>
  <div class="tabs" role="tablist" aria-label="Walkthrough steps">
    {steps.map((s, i) => (
      <button type="button" role="tab" id={`pt-${i}`} aria-controls="pp" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
        <span class="bar"><i></i></span>
        <span class="lbl"><span class="n">{s.n}</span>{s.tag}</span>
      </button>
    ))}
  </div>
  <div class="panel" id="pp" role="tabpanel">
    <div class="copy">
      {steps.map((s, i) => (
        <div class:list={['txt', { on: i === 0 }]} data-txt={i}>
          <h3 class="m-h3">{s.title}</h3>
          <p class="body">{s.body}</p>
        </div>
      ))}
    </div>
    <figure class="frame win">
      <div class="frame-bar"><span class="dots"><i></i><i></i><i></i></span><span class="url" data-url>{steps[0].url}</span></div>
      <div class="view">
        {steps.map((s, i) => <img src={shot(s)} width="2880" height="1800" alt={`${s.tag}: the Siar dashboard`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" class:list={[{ on: i === 0 }]} data-shot={i} data-url={s.url} />)}
      </div>
    </figure>
  </div>
  <ol class="stack">
    {steps.map((s) => (
      <li>
        <p class="m-kicker"><span class="n">{s.n}</span><span class="rule"></span>{s.tag}</p>
        <h3 class="m-h3">{s.title}</h3>
        <p class="body">{s.body}</p>
        <figure class="frame"><div class="frame-bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">{s.url}</span></div><div class="crop"><img src={shot(s)} width="2880" height="1800" alt={`${s.tag}: the Siar dashboard`} loading="lazy" decoding="async" style={`--fx:${s.crop[0] * 100}%;--fy:${s.crop[1] * 100}%;--z:${s.crop[2]}`} /></div></figure>
      </li>
    ))}
  </ol>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const txts = [...root.querySelectorAll<HTMLElement>('[data-txt]')];
    const shots = [...root.querySelectorAll<HTMLImageElement>('[data-shot]')];
    const url = root.querySelector<HTMLElement>('[data-url]')!;
    const ms = Number(root.dataset.ms);
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, timer = 0, visible = false, held = false;
    const running = () => visible && !held && !still;
    const show = (i: number) => {
      cur = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === cur)); t.classList.toggle('done', k < cur); });
      txts.forEach((t, k) => t.classList.toggle('on', k === cur));
      shots.forEach((s, k) => s.classList.toggle('on', k === cur));
      url.textContent = shots[cur].dataset.url ?? '';
      // restart the progress line on the active tab
      root.classList.remove('run'); void root.offsetWidth; root.classList.toggle('run', running());
    };
    const sync = () => {
      clearInterval(timer);
      root.classList.toggle('run', running());
      if (running()) timer = window.setInterval(() => show(cur + 1), ms);
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => { show(i); sync(); }));
    root.querySelector('.tabs')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k !== 'ArrowRight' && k !== 'ArrowLeft') return;
      show(cur + (k === 'ArrowRight' ? 1 : -1)); tabs[cur].focus(); sync();
    });
    root.addEventListener('pointerenter', () => { held = true; sync(); });
    root.addEventListener('pointerleave', () => { held = false; sync(); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.35 }).observe(root);
    show(0);
  });
</script>
<style>
  .tabs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin-bottom: clamp(32px, 4vw, 48px); }
  .tabs button { display: flex; flex-direction: column; gap: 12px; padding: 0 0 4px; border: 0; background: none; font: inherit; text-align: left; cursor: pointer; color: var(--text-faint); transition: color 300ms; }
  .tabs button:hover, .tabs button[aria-selected='true'], .tabs button.done { color: var(--text); }
  .bar { position: relative; height: 2px; border-radius: 2px; background: var(--border); overflow: hidden; }
  .bar i { position: absolute; inset: 0; background: var(--text); transform: scaleX(0); transform-origin: left; }
  .done .bar i, [aria-selected='true'] .bar i { transform: none; }
  .run [aria-selected='true'] .bar i { animation: fill var(--ms) linear both; }
  @keyframes fill { from { transform: scaleX(0); } to { transform: none; } }
  .lbl { display: flex; gap: 10px; font-family: var(--mono); font-size: var(--fs-12); line-height: 16px; letter-spacing: .06em; text-transform: uppercase; }
  .lbl .n { color: var(--text-subtle); }
  .panel { display: grid; grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .copy { display: grid; }
  .txt { grid-area: 1 / 1; opacity: 0; transform: translateY(8px); transition: opacity 300ms, transform 500ms var(--ease-out); visibility: hidden; }
  .txt.on { opacity: 1; transform: none; visibility: visible; }
  .body { font-size: var(--fs-18); line-height: 28px; color: var(--text-muted); margin: 0; }
  .view { position: relative; aspect-ratio: 1440 / 900; background: var(--bg); }
  .view img { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 350ms; }
  .view img.on { opacity: 1; }
  .stack { display: none; list-style: none; margin: 0; padding: 0; }
  @media (max-width: 860px) {
    .tabs, .panel { display: none; }
    .stack { display: block; }
    .stack li { margin: 0 0 56px; }
    .stack .body { font-size: var(--fs-16); line-height: 26px; margin-bottom: 20px; }
    /* a fixed crop on the step's subject, so the shot stays readable at phone width */
    .crop { aspect-ratio: 4 / 3; overflow: hidden; }
    .crop img { width: 100%; height: 100%; object-fit: cover; transform-origin: var(--fx) var(--fy); transform: scale(var(--z)); }
  }
  @media (prefers-reduced-motion: reduce) { .txt, .view img { transition: none; } }
</style>
