---
/** Hero overlay: the same post as one API request. Hand-set colours so it reads at a glance. */
---
<div class="cc">
  <div class="cc-head"><span class="mth">POST</span><span class="path">/api/v1/post</span><span class="ok">201 Created</span></div>
<pre><code>{'{'}
  <b>"socialAccountTypes"</b>: [<s>"INSTAGRAM"</s>, <s>"TIKTOK"</s>,
    <s>"FACEBOOK"</s>, <s>"THREADS"</s>, <s>"LINKEDIN"</s>,
    <s>"GOOGLE_BUSINESS"</s>],
  <b>"postDate"</b>: <s>"2026-10-16T01:30:00Z"</s>,
  <b>"data"</b>: {'{'}
    <b>"THREADS"</b>: {'{'} <b>"text"</b>: <s>"Back Friday."</s> {'}'},
    <i>…one block per network</i>
  {'}'}
{'}'}</code></pre>
</div>
<style>
  .cc { width: 380px; border-radius: 16px; background: #121211; color: #d9d6cd; box-shadow: 0 0 0 1px rgba(255, 255, 255, .06), 0 30px 60px -24px rgba(11, 11, 10, .5); overflow: hidden; }
  .cc-head { display: flex; align-items: center; gap: 10px; padding: 11px 16px; border-bottom: 1px solid rgba(255, 255, 255, .08); font-family: var(--mono); font-size: var(--fs-12); line-height: 16px; }
  .mth { color: #f3efe4; font-weight: 500; }
  .path { color: #a3a19a; flex: 1; }
  .ok { color: #6fd29a; }
  pre { margin: 0; padding: 14px 16px 16px; font-family: var(--mono); font-size: var(--fs-12); line-height: 19px; overflow: hidden; white-space: pre; }
  b { font-weight: 400; color: #f3efe4; }
  s { text-decoration: none; color: #e6b98a; }
  i { font-style: normal; color: #75736c; }
</style>
