---
import { SIGNUP_URL } from '../config';
import { PLANS } from '../lib/plans';
interface Props { title?: string; text?: string }
const free = PLANS.FREE;
const { title = 'Start building today', text = `The Free plan includes ${free.posts} posts and ${free.uploads} uploads a month across ${free.teams} teams. No card needed.` } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="cta">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn primary lg" href={SIGNUP_URL}>Get an API key</a>
        <a class="btn lg" href="/docs/quickstart">Read the quickstart</a>
      </div>
    </div>
  </div>
</section>
<style>
  .cta { border-top: 1px solid var(--text); padding: 40px 0 0; display: flex; gap: 24px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .cta h2 { margin-bottom: 8px; }
  .cta p { margin: 0; max-width: 560px; }
</style>
