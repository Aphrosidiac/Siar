---
import { PLANS, TIERS, fmtCents, fmtQuota } from '../lib/plans';
import { SIGNUP_URL } from '../config';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const yearlySaving = (() => {
  const p = PLANS.PRO;
  if (!p.priceMonthlyCents || !p.priceYearlyMonthlyCents) return null;
  return Math.round((1 - p.priceYearlyMonthlyCents / p.priceMonthlyCents) * 100);
})();
---
<div class="pc" data-billing="yearly">
  <div class="toggle" role="group" aria-label="Billing period">
    <button type="button" data-set="monthly" aria-pressed="false">Monthly</button>
    <button type="button" data-set="yearly" aria-pressed="true">Yearly{yearlySaving ? <span class="badge accent">save {yearlySaving}%</span> : null}</button>
  </div>
  <div class="cards">
    {TIERS.map((t) => {
      const p = PLANS[t];
      const custom = p.priceMonthlyCents === null;
      return (
        <div class:list={['plan', { featured: t === 'PRO' }]}>
          <div class="head">
            <div class="hrow"><h3>{p.name}</h3>{t === 'PRO' && <span class="label pop">Most popular</span>}</div>
            <p class="tag">{p.tagline}</p>
          </div>
          <div class="price">
            {custom ? <span class="amt">Custom</span> : (
              <>
                <span class="amt m">{fmtCents(p.priceMonthlyCents)}</span>
                <span class="amt y">{fmtCents(p.priceYearlyMonthlyCents)}</span>
                <span class="per">/ month</span>
              </>
            )}
          </div>
          <p class="billed">{custom ? 'Quoted per organization' : p.priceMonthlyCents === 0 ? 'No card needed' : <><span class="m">Billed monthly</span><span class="y">Billed yearly</span></>}</p>
          <a class:list={['btn', t === 'PRO' ? 'primary' : '']} href={custom ? '/contact' : SIGNUP_URL}>{custom ? 'Talk to us' : p.priceMonthlyCents === 0 ? 'Start free' : `Choose ${p.name}`}</a>
          {!compact && (
            <ul>
              <li><strong>{fmtQuota(p.posts)}</strong> posts / month</li>
              <li><strong>{fmtQuota(p.comments)}</strong> comments / month</li>
              <li><strong>{fmtQuota(p.uploads)}</strong> uploads / month</li>
              <li><strong>{p.teams === null ? 'Unlimited' : p.teams}</strong> teams{p.teams === null ? ', so unlimited accounts' : ''}</li>
              <li>{p.analytics ? 'Analytics included' : 'No analytics'}</li>
              <li>{t === 'ENTERPRISE' ? 'Raisable quotas, caps and rate limits' : 'Full API, webhooks, SDK, CLI, MCP'}</li>
            </ul>
          )}
        </div>
      );
    })}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.pc').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) =>
      b.addEventListener('click', () => {
        root.dataset.billing = b.dataset.set!;
        root.querySelectorAll('[data-set]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }),
    );
  });
</script>
<style>
  .toggle { display: inline-flex; gap: 2px; padding: 2px; border-radius: var(--radius); background: var(--bg-muted); margin: 0 0 24px; }
  .toggle button { font: inherit; font-size: var(--fs-13); line-height: 20px; font-weight: 500; border: 0; background: transparent; padding: 5px 12px; border-radius: var(--radius-sm); cursor: pointer; color: var(--text-subtle); display: inline-flex; align-items: center; gap: 8px; transition: background var(--t-micro), color var(--t-micro); }
  .toggle button:hover { color: var(--text); }
  .toggle button[aria-pressed='true'] { background: var(--bg-elevated); color: var(--text); box-shadow: var(--shadow-sm); }
  .toggle .badge { background: var(--bg-muted); }
  /* one surface; hairlines between plans (the 1px gap shows the border colour) */
  .cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; text-align: left; }
  @media (max-width: 1000px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .cards { grid-template-columns: minmax(0, 1fr); } }
  .plan { padding: 24px; background: var(--bg-elevated); display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .plan.featured { box-shadow: inset 0 2px 0 var(--text); }
  .hrow { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .hrow h3 { margin: 0; font-size: var(--fs-18); }
  .pop { margin: 0; color: var(--text); white-space: nowrap; }
  .tag { margin: 4px 0 0; font-size: var(--fs-14); line-height: 20px; color: var(--text-subtle); }
  .price { display: flex; align-items: baseline; gap: 6px; }
  .amt { font-size: var(--fs-38); line-height: 44px; font-weight: 600; letter-spacing: -0.03em; color: var(--text); font-variant-numeric: tabular-nums; }
  .per { color: var(--text-subtle); font-size: var(--fs-14); }
  .billed { margin: 0; font-size: var(--fs-13); line-height: 20px; color: var(--text-subtle); min-height: 20px; }
  .pc[data-billing='yearly'] .m, .pc[data-billing='monthly'] .y { display: none; }
  ul { list-style: none; padding: 0; margin: 8px 0 0; border-top: 1px solid var(--border); padding-top: 16px; }
  li { font-size: var(--fs-14); line-height: 20px; margin: 0 0 10px; padding-left: 18px; position: relative; color: var(--text-muted); }
  li::before { content: ''; position: absolute; left: 2px; top: 8px; width: 8px; height: 1px; background: var(--text-faint); }
</style>
