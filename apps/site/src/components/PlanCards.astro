---
import { PLANS, TIERS, TRIAL_DAYS, money, isFree, isCustom, monthsFree, fmtQuota, brandsLabel, priceOf, formatPrice } from '../lib/plans';
import { SIGNUP_URL } from '../config';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const free = monthsFree('PRO');
type T = (typeof TIERS)[number];
type Cur = 'myr' | 'usd';
/** Free's tagline reads "Try Siar" (strike plan 0.13) until PLANS.FREE.tagline changes in the API's plans.ts. */
const tagline = (t: T) => (t === 'FREE' ? 'Try Siar' : PLANS[t].tagline);
/** Monthly price per brand, for plans with more than one brand: "RM9.90" / "$4.90". */
const perBrand = (t: T, c: Cur) => {
  const n = PLANS[t].teams;
  const v = priceOf(t, 'MONTHLY', c);
  return n && n > 1 && v ? formatPrice(Math.round(v / n), c) : null;
};
const other = (c: Cur) => (c === 'myr' ? 'outside Malaysia' : 'if billed in Malaysia');
const flip = (c: Cur): Cur => (c === 'myr' ? 'usd' : 'myr');
const CURS: Cur[] = ['usd', 'myr'];
---
<script is:inline>
  // The visitor's own list first: ringgit in Malaysia, US dollars elsewhere. Both are in the HTML; this only picks which is large.
  try { var tz = Intl.DateTimeFormat().resolvedOptions().timeZone; if (tz === 'Asia/Kuala_Lumpur' || tz === 'Asia/Kuching') document.documentElement.dataset.cur = 'myr'; } catch (e) {}
</script>
<div class="pc" data-billing="monthly">
  <div class="toggle" role="group" aria-label="Billing period">
    <button type="button" data-set="monthly" aria-pressed="true">Monthly</button>
    <button type="button" data-set="yearly" aria-pressed="false">Yearly{free ? <span class="badge accent">{free} months free</span> : null}</button>
  </div>
  <div class="cards">
    {TIERS.map((t) => {
      const p = PLANS[t];
      const custom = isCustom(t);
      const zero = isFree(t);
      const paid = !custom && !zero;
      const period = p.oneTime ? 'one-time' : 'a month';
      return (
        <div class:list={['plan', { featured: t === 'PRO' }]}>
          <div class="head">
            <div class="hrow"><h3>{p.name}</h3>{t === 'PRO' && <span class="label pop">Most popular</span>}</div>
            <p class="tag">{tagline(t)}</p>
          </div>
          {paid ? CURS.map((c) => (
            <div class={`cur-${c}`}>
              <div class="price">
                <span class="amt m">{money(t, 'MONTHLY', c)}</span>
                <span class="amt y">{money(t, 'YEARLY', c)}</span>
                <span class="per"><span class="m">a month</span><span class="y">a year</span></span>
              </div>
              <p class="usd"><span class="m">{money(t, 'MONTHLY', flip(c))} {other(c)}</span><span class="y">{money(t, 'YEARLY', flip(c))} {other(c)}</span></p>
            </div>
          )) : (
            <div>
              <div class="price"><span class="amt">{custom ? 'Custom' : 'Free'}</span></div>
              <p class="usd">{custom ? 'Custom. Talk to us.' : `${p.posts} free posts to try, once`}</p>
            </div>
          )}
          <p class="billed">{custom ? 'Priced for your volume' : zero ? 'No card, no time limit' : <><span class="m">{p.trial ? `${TRIAL_DAYS}-day free trial, by card` : 'Billed monthly by card'}</span><span class="y">{monthsFree(t)} months free, billed yearly</span></>}</p>
          <a class:list={['btn', t === 'PRO' ? 'primary' : '']} href={custom ? '/contact' : SIGNUP_URL}>{custom ? 'Talk to us' : zero ? `Start with ${p.posts} free posts` : p.trial ? `Start the ${TRIAL_DAYS}-day trial` : `Choose ${p.name}`}</a>
          {!compact && (
            t === 'ENTERPRISE' ? (
              <ul>
                <li>Quotas, daily caps and rate limits set for your organization</li>
                <li>Invoices</li>
                <li>An SLA by contract</li>
              </ul>
            ) : (
              <ul>
                <li><strong>{fmtQuota(p.posts)}</strong> {p.oneTime ? 'free posts to try, one-time' : 'posts a month'}</li>
                <li><strong>{fmtQuota(p.comments)}</strong> comments and <strong>{fmtQuota(p.uploads)}</strong> uploads {period}</li>
                <li><strong>{brandsLabel(p.teams)}</strong>{perBrand(t, 'myr') && CURS.map((c) => <span class={`cur-${c}`}>, {perBrand(t, c)} each ({perBrand(t, flip(c))} {other(c)})</span>)}</li>
                <li>No per-account fees</li>
                <li>{p.analytics ? 'Account and post analytics' : 'No analytics'}</li>
                <li>The REST API and signed webhooks</li>
              </ul>
            )
          )}
        </div>
      );
    })}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.pc').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) =>
      b.addEventListener('click', () => {
        root.dataset.billing = b.dataset.set!;
        root.querySelectorAll('[data-set]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }),
    );
  });
</script>
<style>
  /* currency view: US dollars unless the visitor is in Malaysia (set by the inline script above) */
  :global(html[data-cur='myr'] .cur-usd), :global(html:not([data-cur='myr']) .cur-myr) { display: none; }
  .toggle { display: inline-flex; gap: 2px; padding: 2px; border-radius: var(--radius); background: var(--bg-muted); margin: 0 0 24px; }
  .toggle button { font: inherit; font-size: var(--fs-13); line-height: 20px; font-weight: 500; border: 0; background: transparent; padding: 5px 12px; border-radius: var(--radius-sm); cursor: pointer; color: var(--text-subtle); display: inline-flex; align-items: center; gap: 8px; transition: background var(--t-micro), color var(--t-micro); }
  .toggle button:hover { color: var(--text); }
  .toggle button[aria-pressed='true'] { background: var(--bg-elevated); color: var(--text); box-shadow: var(--shadow-sm); }
  .toggle .badge { background: var(--bg-muted); }
  /* one surface; hairlines between plans (the 1px gap shows the border colour) */
  .cards { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; text-align: left; }
  @media (max-width: 1180px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } .plan:last-child { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .cards { grid-template-columns: minmax(0, 1fr); } .plan:last-child { grid-column: auto; } }
  .plan { padding: 24px 20px; background: var(--bg-elevated); display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .plan.featured { box-shadow: inset 0 2px 0 var(--text); }
  .hrow { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .hrow h3 { margin: 0; font-size: var(--fs-18); }
  .pop { margin: 0; color: var(--text); white-space: nowrap; }
  .tag { margin: 4px 0 0; font-size: var(--fs-14); line-height: 20px; color: var(--text-subtle); }
  .price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 6px; }
  .amt { font-size: var(--fs-30); line-height: 38px; font-weight: 600; letter-spacing: -0.03em; color: var(--text); font-variant-numeric: tabular-nums; }
  .per { color: var(--text-subtle); font-size: var(--fs-14); }
  .usd { margin: 8px 0 0; font-size: var(--fs-14); line-height: 20px; color: var(--text-muted); min-height: 20px; }
  .billed { margin: 0; font-size: var(--fs-13); line-height: 20px; color: var(--text-subtle); min-height: 20px; }
  .pc[data-billing='yearly'] .m, .pc[data-billing='monthly'] .y { display: none; }
  ul { list-style: none; padding: 0; margin: 8px 0 0; border-top: 1px solid var(--border); padding-top: 16px; }
  li { font-size: var(--fs-14); line-height: 20px; margin: 0 0 10px; padding-left: 18px; position: relative; color: var(--text-muted); }
  li::before { content: ''; position: absolute; left: 2px; top: 8px; width: 8px; height: 1px; background: var(--text-faint); }
</style>
