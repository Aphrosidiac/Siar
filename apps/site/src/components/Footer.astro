---
import { NETWORKS } from '../lib/networks';
import { LEGAL_ENTITY, CONTACT_EMAIL, COMPANY_URL, SIGNUP_URL } from '../config';
const year = 2026;
const cols = [
  { h: 'Product', l: [['/features', 'Product tour'], ['/pricing', 'Pricing'], ['/platforms', 'Networks'], ['/use-cases', 'Use cases'], ['/changelog', 'Changelog']] },
  { h: 'Build', l: [['/docs/quickstart', 'Quickstart'], ['/docs', 'Documentation'], ['/docs/api', 'API reference'], ['/docs/webhooks', 'Webhooks'], ['/docs/sdk-cli-mcp', 'SDK, CLI and MCP'], ['/openapi.json', 'OpenAPI']] },
  { h: 'Use cases', l: [['/use-cases/social-media-posting-api', 'Posting API'], ['/use-cases/social-media-scheduling-api', 'Scheduling API'], ['/use-cases/multi-tenant-social-media-api', 'Multi-tenant'], ['/use-cases/social-media-api-for-ai-agents', 'For AI agents']] },
  { h: 'Company', l: [['/about', 'About'], ['/contact', 'Contact'], ['/terms', 'Terms'], ['/privacy', 'Privacy'], ['/data-deletion', 'Data deletion']] },
];
---
<footer class="ftr m-ink">
  <div class="m-wide">
    <div class="top">
      <div class="lead-col">
        <p class="say">Write it once.<br /><span class="m-dim">Siar it everywhere.</span></p>
        <div class="m-actions"><a class="pill ink" href={SIGNUP_URL}>Start free <span class="arr" aria-hidden="true">→</span></a><a class="pill" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></div>
      </div>
      {cols.map((c) => (
        <div class="col">
          <p class="h">{c.h}</p>
          <ul>{c.l.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <p class="nets">{NETWORKS.map((n, i) => <><a href={`/${n.apiSlug}`}>{n.name}</a>{i < NETWORKS.length - 1 ? <span aria-hidden="true"> / </span> : ''}</>)}</p>
    <div class="word" aria-hidden="true">
      <svg viewBox="0.05 -0.8 24 24" fill="currentColor"><path d="M5.6 7.2a4 4 0 1 1-2.4 7.2l-1.6 1.2.5-2.6a4 4 0 0 1 3.5-5.8Z"/><path transform="rotate(-38 5.6 11.2)" d="M11 10.5 20 8.7a2.5 2.5 0 0 1 0 5L11 11.9Z"/><path d="M11 10.5 20 8.7a2.5 2.5 0 0 1 0 5L11 11.9Z"/><path transform="rotate(38 5.6 11.2)" d="M11 10.5 20 8.7a2.5 2.5 0 0 1 0 5L11 11.9Z"/></svg>
      <span>siar</span>
    </div>
    <div class="bottom">
      <p><strong>Siar by <a href={COMPANY_URL} rel="noopener">FF Dev Studio</a></strong> · © {year} {LEGAL_ENTITY}</p>
      <p class="tm">Network names are trademarks of their owners, used only to describe compatibility. Siar is not affiliated with or endorsed by any of them.</p>
    </div>
  </div>
</footer>
<style>
  .ftr { padding: clamp(72px, 9vw, 120px) 0 28px; overflow: hidden; }
  .top { display: grid; grid-template-columns: minmax(0, 2fr) repeat(4, minmax(0, 1fr)); gap: 40px; }
  .say { font-size: clamp(30px, 3.4vw, 46px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 600; color: var(--text); margin: 0 0 28px; }
  .h { font-family: var(--mono); font-size: var(--fs-11); letter-spacing: .08em; text-transform: uppercase; color: var(--text-faint); margin: 6px 0 16px; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin: 0 0 10px; }
  li a { font-size: var(--fs-15); line-height: 20px; color: var(--text-muted); text-decoration: none; }
  li a:hover { color: var(--text); }
  .nets { margin: 64px 0 0; padding-top: 20px; border-top: 1px solid var(--border); font-size: var(--fs-13); line-height: 22px; color: var(--text-faint); }
  .nets a { color: var(--text-subtle); text-decoration: none; }
  .nets a:hover { color: var(--text); }
  .word { display: flex; align-items: center; gap: .04em; margin: 40px 0 8px; color: var(--text); font-size: clamp(120px, 34vw, 500px); line-height: .8; font-weight: 600; letter-spacing: -0.07em; user-select: none; }
  .word svg { width: .72em; height: .72em; flex: none; margin-right: .06em; }
  .word span { transform: translateY(-.03em); }
  .bottom { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; border-top: 1px solid var(--border); padding-top: 20px; }
  .bottom p { margin: 0; font-size: var(--fs-13); line-height: 20px; color: var(--text-subtle); }
  .bottom strong { color: var(--text); font-weight: 500; }
  .bottom a { color: inherit; }
  .tm { max-width: 560px; }
  @media (max-width: 1000px) { .top { grid-template-columns: repeat(2, minmax(0, 1fr)); } .lead-col { grid-column: 1 / -1; } }
</style>
