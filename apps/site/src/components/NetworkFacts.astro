---
import { CONNECT_LABEL, mb, seconds, type NetworkInfo } from '../lib/networks';
import { fmtInt } from '../lib/plans';
interface Props { n: NetworkInfo }
const { n } = Astro.props;
const l = n.adapter.limits;
const mimes = (m: string[]) => (m.length ? m.map((x) => x.split('/')[1].replace('x-', '').replace('quicktime', 'mov').replace('svg+xml', 'svg')).join(', ') : 'any type');
const channels = { none: 'Not needed', optional: 'Optional: pick a channel after connecting', required: 'Required: pick a channel after connecting' }[n.adapter.capabilities.channels];
const rows: [string, string][] = [
  ['Connection', CONNECT_LABEL[n.adapter.capabilities.connect]],
  ['Channel', channels],
  ['Post types', n.postTypes.map((t) => t.toLowerCase().replace(/_/g, ' ')).join(', ')],
  ['Text length', l.textMax ? `${fmtInt(l.textMax)} characters` : 'No limit set'],
  ...(l.titleMax ? ([['Title length', `${fmtInt(l.titleMax)} characters`]] as [string, string][]) : []),
  ['Comment length', l.commentMax ? `${fmtInt(l.commentMax)} characters` : 'Comments not supported'],
  ['Media per post', `Up to ${l.media.maxItems}`],
];
const m = l.media;
---
<div class="table-wrap"><table>
  <tbody>{rows.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
</table></div>
<h3 id="media">Media rules</h3>
<div class="table-wrap"><table>
  <thead><tr><th>Kind</th><th>Formats</th><th class="num">Max size</th><th>Duration</th><th>Other</th></tr></thead>
  <tbody>
    {m.image && <tr><td>Image</td><td>{mimes(m.image.mimes)}</td><td class="num">{mb(m.image.maxBytes)}</td><td>n/a</td><td>{[m.image.minWidth ? `min width ${m.image.minWidth}px` : '', m.image.maxWidth ? `max width ${m.image.maxWidth}px` : '', m.image.aspect ? `aspect ${m.image.aspect.join(':')}` : ''].filter(Boolean).join(', ') || 'None'}</td></tr>}
    {m.video && <tr><td>Video</td><td>{mimes(m.video.mimes)}</td><td class="num">{mb(m.video.maxBytes)}</td><td>{m.video.minSeconds ? `${seconds(m.video.minSeconds)} to ` : 'Up to '}{seconds(m.video.maxSeconds)}</td><td>{m.video.aspect ? `aspect ${m.video.aspect.join(':')}` : 'None'}</td></tr>}
    {m.document && <tr><td>Document</td><td>{mimes(m.document.mimes)}</td><td class="num">{mb(m.document.maxBytes)}</td><td>n/a</td><td>None</td></tr>}
    {!m.image && !m.video && !m.document && <tr><td colspan="5">This network takes text only.</td></tr>}
  </tbody>
</table></div>
