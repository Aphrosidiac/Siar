---
import SchemaFields from './SchemaFields.astro';
import CodeBlock from './CodeBlock.astro';
import { toFields, typeLabel, curl, countFields, type Op } from '../lib/openapi';
/** `sameAs`: an earlier operation on this page returns the same shape; link to it instead of repeating it. */
interface Props { op: Op; sameAs?: { anchor: string; summary: string } }
const { op, sameAs } = Astro.props;
const params = op.parameters;
const bodyFull = op.body ? toFields(op.body.schema) : [];
/** Bodies with hundreds of nested fields are shown four levels deep; every field is in /openapi.json. */
const bodyCut = countFields(bodyFull) > 300;
const bodyFields = bodyCut ? toFields(op.body!.schema, 0, 4) : bodyFull;
/** Very deep response schemas (automation) are cut at four levels so a reference page stays under 1 MB of HTML
 * (docs/seo/ACCEPTANCE.md); the full shape is always in /openapi.json. */
const respFull = op.response?.schema ? toFields(op.response.schema) : [];
const respCount = countFields(respFull);
const respFields = respCount > 200 ? toFields(op.response!.schema, 0, 2) : respCount > 60 ? toFields(op.response!.schema, 0, 3) : respFull;
const statusText: Record<string, string> = { '400': 'Validation failed', '401': 'Missing or invalid API key', '403': 'Plan limit or permission', '404': 'Not found', '409': 'Conflict', '429': 'Rate limited', '500': 'Server error', '502': 'Network error', '503': 'Unavailable' };
const sample = curl(op);
---
<section class="op" id={op.anchor}>
  <div class="oh">
    <span class={`method ${op.method}`}>{op.method}</span>
    <code class="path">{op.path.replace(/\/$/, '') || '/'}</code>
  </div>
  <h3><a href={`#${op.anchor}`}>{op.summary}</a></h3>
  <p class="xs muted"><code>{op.operationId}</code>{op.public ? ' · no API key needed' : ' · requires x-api-key'}</p>

  {params.length > 0 && (
    <>
      <h4>Parameters</h4>
      <div class="table-wrap"><table>
        <thead><tr><th>Name</th><th>In</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>{params.map((p: any) => (
          <tr>
            <td><code>{p.name}</code>{p.required ? <span class="req"> required</span> : null}</td>
            <td>{p.in}</td>
            <td><code>{typeLabel(p.schema)}</code></td>
            <td class="xs">{[p.schema?.enum ? `One of ${p.schema.enum.join(', ')}` : '', p.schema?.default !== undefined ? `default ${JSON.stringify(p.schema.default)}` : '', p.schema?.nullable ? 'nullable' : ''].filter(Boolean).join(' · ')}</td>
          </tr>
        ))}</tbody>
      </table></div>
    </>
  )}

  {op.body && (
    <>
      <h4>Request body <span class="xs muted"><code>{op.body.contentType}</code></span></h4>
      {bodyFields.length ? <SchemaFields fields={bodyFields} open={countFields(bodyFields) < 40} /> : <p class="small muted">See the example below.</p>}
      {bodyCut && <p class="small muted">Fields nested more than four levels deep are in the <a href="/openapi.json">OpenAPI file</a>.</p>}
    </>
  )}

  <h4>Example</h4>
  <CodeBlock code={sample} lang="bash" />

  {op.response && (
    <>
      <h4>Response <span class="xs muted"><code>{op.response.status}</code></span></h4>
      {sameAs ? (
        <p class="small">Same fields as the response of <a href={`#${sameAs.anchor}`}>{sameAs.summary}</a>.</p>
      ) : respFields.length ? (
        <details class="resp"><summary>{respFields.length} top-level fields</summary><SchemaFields fields={respFields} /></details>
      ) : <p class="small muted">{op.response.schema ? `A ${typeLabel(op.response.schema)}.` : 'No body.'}</p>}
    </>
  )}
  {op.errorStatuses.length > 0 && <p class="xs muted">Errors: {op.errorStatuses.map((s, i) => <><code>{s}</code> {statusText[s] ?? ''}{i < op.errorStatuses.length - 1 ? ' · ' : ''}</>)}</p>}
</section>
<style>
  .op { border-top: 1px solid var(--border); padding: 32px 0; }
  .oh { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  .path { font-size: var(--fs-14); background: none !important; padding: 0 !important; overflow-wrap: anywhere; }
  .op h3 { font-size: var(--fs-20); margin: 0 0 4px; }
  .op h3 a { color: var(--text); text-decoration: none; }
  .op h3 a:hover { text-decoration: underline; text-decoration-color: var(--border-strong); text-underline-offset: 3px; }
  .op h4 { font-size: var(--fs-15); margin: 20px 0 8px; }
  .req { font-family: var(--mono); font-size: var(--fs-11); font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--text); }
  .resp { margin: 0 0 12px; }
  .resp > summary { font-size: var(--fs-14); color: var(--text-subtle); margin-bottom: 8px; }
</style>
