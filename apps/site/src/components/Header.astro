---
import Logo from './Logo.astro';
import { DASHBOARD_URL, SIGNUP_URL } from '../config';
const path = Astro.url.pathname;
const links = [
  { href: '/features', label: 'Features' },
  { href: '/platforms', label: 'Platforms' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
  { href: '/docs/api', label: 'API reference' },
  { href: '/blog', label: 'Blog' },
];
const active = (h: string) => (h === '/docs' ? path === '/docs' || (path.startsWith('/docs/') && !path.startsWith('/docs/api')) : path === h || path.startsWith(h + '/'));
---
<header class="hdr">
  <div class="container in">
    <a href="/" class="brand" aria-label="Siar home"><Logo size={26} /></a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} class:list={[{ on: active(l.href) }]}>{l.label}</a>)}
    </nav>
    <div class="right">
      <button class="theme" type="button" aria-label="Toggle dark mode" data-theme-toggle>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <a href={DASHBOARD_URL} class="btn sm signin">Sign in</a>
      <a href={SIGNUP_URL} class="btn sm primary cta">Get an API key</a>
      <details class="mnav">
        <summary aria-label="Menu"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
        <div class="panel">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={DASHBOARD_URL}>Sign in</a>
          <a href={SIGNUP_URL} class="btn primary">Get an API key</a>
        </div>
      </details>
    </div>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: saturate(1.4) blur(10px); -webkit-backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--border); }
  .in { display: flex; align-items: center; gap: 24px; height: 60px; }
  .brand { color: var(--fg); display: inline-flex; }
  .brand:hover { text-decoration: none; }
  .nav { display: flex; gap: 4px; flex: 1; }
  .nav a { font-size: 14px; color: var(--fg-2); padding: 6px 10px; border-radius: 6px; font-weight: 500; }
  .nav a:hover { color: var(--fg); background: var(--bg-muted); text-decoration: none; }
  .nav a.on { color: var(--fg); }
  .right { display: flex; gap: 8px; align-items: center; margin-left: auto; }
  .theme { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid var(--border); background: transparent; color: var(--fg-2); cursor: pointer; }
  .theme:hover { color: var(--fg); background: var(--bg-muted); }
  .theme .moon { display: none; }
  :global(:root[data-theme='dark']) .theme .sun { display: none; }
  :global(:root[data-theme='dark']) .theme .moon { display: block; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .theme .sun { display: none; } :global(:root:not([data-theme='light'])) .theme .moon { display: block; } }
  .mnav { display: none; position: relative; }
  .mnav summary { list-style: none; width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border); border-radius: 8px; color: var(--fg); }
  .mnav summary::-webkit-details-marker { display: none; }
  .panel { position: absolute; right: 0; top: 44px; width: min(280px, calc(100vw - 32px)); background: var(--bg-elev); border: 1px solid var(--border); border-radius: 8px; box-shadow: var(--shadow); padding: 8px; display: flex; flex-direction: column; }
  .panel a { padding: 10px 12px; color: var(--fg); font-size: 15px; border-radius: 6px; }
  .panel a:hover { background: var(--bg-muted); text-decoration: none; }
  .panel .btn { margin-top: 8px; color: var(--accent-fg); }
  @media (max-width: 960px) { .nav, .signin { display: none; } .mnav { display: block; } }
  @media (max-width: 480px) { .cta { display: none; } }
</style>
