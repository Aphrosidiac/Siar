---
import Logo from './Logo.astro';
import { DASHBOARD_URL, SIGNUP_URL } from '../config';
const path = Astro.url.pathname;
const links = [
  { href: '/features', label: 'Features' },
  { href: '/platforms', label: 'Platforms' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
  { href: '/docs/api', label: 'API reference' },
];
const active = (h: string) => (h === '/docs' ? path === '/docs' || (path.startsWith('/docs/') && !path.startsWith('/docs/api')) : path === h || path.startsWith(h + '/'));
---
<header class="hdr">
  <div class="container in">
    <a href="/" class="brand" aria-label="Siar home"><Logo /></a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} class:list={[{ on: active(l.href) }]}>{l.label}</a>)}
    </nav>
    <div class="right">
      <button class="theme" type="button" aria-label="Toggle dark mode" data-theme-toggle>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <a href={DASHBOARD_URL} class="btn sm ghost signin">Sign in</a>
      <a href={SIGNUP_URL} class="btn sm primary cta">Get an API key</a>
      <details class="mnav">
        <summary aria-label="Menu"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
        <div class="panel">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={DASHBOARD_URL}>Sign in</a>
          <a href={SIGNUP_URL} class="btn primary">Get an API key</a>
        </div>
      </details>
    </div>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter: saturate(1.2) blur(10px); -webkit-backdrop-filter: saturate(1.2) blur(10px); border-bottom: 1px solid var(--border); }
  .in { display: flex; align-items: center; gap: 24px; height: 60px; }
  .brand { color: var(--text); display: inline-flex; text-decoration: none; }
  .nav { display: flex; gap: 2px; flex: 1; }
  .nav a { font-size: var(--fs-14); line-height: 20px; color: var(--text-subtle); padding: 6px 10px; border-radius: var(--radius); font-weight: 500; text-decoration: none; transition: color var(--t-micro), background var(--t-micro); }
  .nav a:hover { color: var(--text); background: var(--bg-hover); }
  .nav a.on { color: var(--text); }
  .right { display: flex; gap: 8px; align-items: center; margin-left: auto; }
  .theme { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius); border: 1px solid transparent; background: transparent; color: var(--text-subtle); cursor: pointer; }
  .theme:hover { color: var(--text); background: var(--bg-hover); }
  .theme .moon { display: none; }
  :global(:root[data-theme='dark']) .theme .sun { display: none; }
  :global(:root[data-theme='dark']) .theme .moon { display: block; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .theme .sun { display: none; } :global(:root:not([data-theme='light'])) .theme .moon { display: block; } }
  .mnav { display: none; position: relative; }
  .mnav summary { list-style: none; width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); }
  .mnav summary::-webkit-details-marker { display: none; }
  .panel { position: absolute; right: 0; top: 44px; width: min(280px, calc(100vw - 32px)); background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow); padding: 4px; display: flex; flex-direction: column; }
  .panel a { padding: 8px 10px; color: var(--text); font-size: var(--fs-14); line-height: 20px; border-radius: var(--radius-sm); text-decoration: none; }
  .panel a:hover { background: var(--bg-hover); }
  .panel .btn { margin: 8px 4px 4px; color: var(--accent-fg); }
  .panel .btn:hover { background: var(--accent-hover); }
  @media (max-width: 960px) { .nav, .signin { display: none; } .mnav { display: block; } }
  @media (max-width: 480px) { .cta { display: none; } }
</style>
