---
import Logo from './Logo.astro';
import { DASHBOARD_URL, SIGNUP_URL } from '../config';
const path = Astro.url.pathname;
const links = [
  { href: '/features', label: 'Product' },
  { href: '/platforms', label: 'Networks' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs', label: 'Docs' },
  { href: '/docs/api', label: 'API' },
];
const active = (h: string) => (h === '/docs' ? path === '/docs' || (path.startsWith('/docs/') && !path.startsWith('/docs/api')) : path === h || path.startsWith(h + '/'));
---
<header class="hdr" data-hdr>
  <div class="bar-in">
    <a href="/" class="brand" aria-label="Siar home"><Logo size={22} /></a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} class:list={[{ on: active(l.href) }]}>{l.label}</a>)}
    </nav>
    <div class="right">
      <button class="theme" type="button" aria-label="Toggle dark mode" data-theme-toggle>
        <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <a href={DASHBOARD_URL} class="signin">Sign in</a>
      <a href={SIGNUP_URL} class="pill ink sm cta">Start free <span class="arr" aria-hidden="true">→</span></a>
      <button class="menu" type="button" aria-expanded="false" aria-controls="m-menu" data-menu-btn><span class="bars" aria-hidden="true"><i></i><i></i></span><span class="lbl">Menu</span></button>
    </div>
  </div>
  <div class="sheet" id="m-menu" data-menu hidden>
    <nav aria-label="Mobile">
      {links.map((l, i) => <a href={l.href} style={`--d:${i}`}><span class="i">0{i + 1}</span>{l.label}</a>)}
    </nav>
    <div class="sheet-foot">
      <a href={SIGNUP_URL} class="pill ink">Start free <span class="arr" aria-hidden="true">→</span></a>
      <a href={DASHBOARD_URL} class="pill">Sign in</a>
    </div>
  </div>
</header>
<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr]')!;
  // over an ink band the bar turns ink too, so it never sits as a pale strip on a dark section
  let raf = 0;
  const onScroll = () => {
    if (raf) return;
    raf = requestAnimationFrame(() => {
      raf = 0;
      hdr.classList.toggle('scrolled', scrollY > 8);
      const y = hdr.offsetHeight - 1;
      const under = document.elementsFromPoint(innerWidth / 2, y).find((el) => !hdr.contains(el));
      hdr.classList.toggle('ink', !!under?.closest('.m-ink'));
    });
  };
  addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll); onScroll();
  const btn = hdr.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const sheet = hdr.querySelector<HTMLElement>('[data-menu]')!;
  const set = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    hdr.classList.toggle('open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) { sheet.hidden = false; requestAnimationFrame(() => sheet.classList.add('on')); }
    else { sheet.classList.remove('on'); setTimeout(() => { if (!hdr.classList.contains('open')) sheet.hidden = true; }, 350); }
  };
  btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && hdr.classList.contains('open')) set(false); });
  matchMedia('(min-width: 961px)').addEventListener('change', (m) => { if (m.matches) set(false); });
</script>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; transition: background 300ms, box-shadow 300ms; }
  .hdr.scrolled { background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: saturate(1.2) blur(12px); -webkit-backdrop-filter: saturate(1.2) blur(12px); box-shadow: 0 1px 0 var(--border); }
  .hdr.ink.scrolled:not(.open) { background: color-mix(in srgb, #0b0b0a 88%, transparent); box-shadow: 0 1px 0 #262622; --text: #f3efe4; --text-subtle: #a19d92; --bg-hover: #1e1e1b; --border-strong: #3a3934; --accent: #f3efe4; --accent-hover: #fff; --accent-fg: #0b0b0a; color: var(--text); }
  .hdr.open { background: var(--bg); box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .bar-in { max-width: 1320px; margin: 0 auto; padding: 0 32px; display: flex; align-items: center; gap: 32px; height: 68px; }
  .brand { color: var(--text); display: inline-flex; text-decoration: none; }
  .nav { display: flex; gap: 4px; flex: 1; }
  .nav a { font-size: var(--fs-15); line-height: 20px; color: var(--text-subtle); padding: 8px 12px; border-radius: 999px; font-weight: 500; text-decoration: none; transition: color var(--t-micro), background var(--t-micro); }
  .nav a:hover { color: var(--text); background: var(--bg-hover); }
  .nav a.on { color: var(--text); }
  .right { display: flex; gap: 12px; align-items: center; margin-left: auto; }
  .signin { font-size: var(--fs-15); font-weight: 500; color: var(--text); text-decoration: none; padding: 8px 4px; }
  .signin:hover { text-decoration: underline; text-underline-offset: 4px; }
  .theme { width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; border: 0; background: transparent; color: var(--text-subtle); cursor: pointer; }
  .theme:hover { color: var(--text); background: var(--bg-hover); }
  .theme .moon { display: none; }
  :global(:root[data-theme='dark']) .theme .sun { display: none; }
  :global(:root[data-theme='dark']) .theme .moon { display: block; }
  .menu { display: none; align-items: center; gap: 10px; height: 36px; padding: 0 14px 0 12px; border-radius: 999px; border: 1px solid var(--border-strong); background: transparent; color: var(--text); font: inherit; font-size: var(--fs-14); font-weight: 500; cursor: pointer; }
  .bars { position: relative; width: 14px; height: 8px; }
  .bars i { position: absolute; left: 0; right: 0; height: 1.5px; background: currentColor; border-radius: 1px; transition: transform 350ms var(--ease-out), top 350ms var(--ease-out); }
  .bars i:first-child { top: 0; } .bars i:last-child { top: 6.5px; }
  .open .bars i:first-child { top: 3.25px; transform: rotate(45deg); }
  .open .bars i:last-child { top: 3.25px; transform: rotate(-45deg); }
  .sheet { position: fixed; inset: 68px 0 0; background: var(--bg); padding: 24px 16px max(24px, env(safe-area-inset-bottom)); display: flex; flex-direction: column; justify-content: space-between; opacity: 0; transition: opacity 300ms; overflow-y: auto; }
  .sheet.on { opacity: 1; }
  .sheet nav { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
  .sheet nav a { display: flex; align-items: baseline; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--border); font-size: 36px; line-height: 1.05; letter-spacing: -0.04em; font-weight: 600; color: var(--text); text-decoration: none; transform: translateY(12px); opacity: 0; transition: transform 600ms var(--ease-out), opacity 600ms var(--ease-out); transition-delay: calc(var(--d) * 50ms + 60ms); }
  .sheet.on nav a { transform: none; opacity: 1; }
  .sheet nav .i { font-family: var(--mono); font-size: var(--fs-12); letter-spacing: 0; color: var(--text-subtle); font-weight: 400; width: 24px; }
  .sheet-foot { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding-top: 24px; }
  .sheet-foot .pill { justify-content: center; }
  @media (max-width: 960px) { .nav, .signin { display: none; } .menu { display: inline-flex; } .bar-in { gap: 16px; } }
  @media (max-width: 640px) { .bar-in { padding: 0 16px; height: 60px; } .sheet { inset: 60px 0 0; } }
  @media (max-width: 480px) { .cta { display: none; } }
  @media (min-width: 961px) { .sheet { display: none !important; } }
</style>
