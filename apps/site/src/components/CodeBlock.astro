---
import { Code } from 'astro:components';
interface Props { code: string; lang?: string; title?: string }
const { code, lang = 'bash', title } = Astro.props;
---
<div class="cb">
  {title && <div class="cbt">{title}</div>}
  <Code code={code} lang={lang as any} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
</div>
<style>
  .cb { margin: 0 0 20px; min-width: 0; }
  .cbt { font-size: var(--fs-12); line-height: 16px; font-family: var(--mono); color: var(--code-muted); background: var(--code-bg); border: 1px solid var(--code-line); border-bottom-color: var(--code-line); padding: 10px 16px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
  .cbt + :global(pre) { border-top-left-radius: 0; border-top-right-radius: 0; border-top: 0; }
  .cb :global(pre) { margin: 0; }
</style>
