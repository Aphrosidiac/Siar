---
/** Neutral monogram tile for a network. We do not ship third-party logos. */
import { META, type NetworkType } from '../lib/networks';
interface Props { type: NetworkType; size?: number }
const { type, size = 36 } = Astro.props;
const m = META[type];
---
<span class="ni" style={`width:${size}px;height:${size}px;font-size:${Math.max(12, Math.round(size * 0.36))}px`} aria-hidden="true">{m.short}</span>
<style>
  .ni { display: inline-flex; align-items: center; justify-content: center; flex: none; border-radius: 8px; border: 1px solid var(--border); background: var(--bg-soft); color: var(--fg); font-weight: 700; letter-spacing: -0.02em; }
</style>
