---
/** Network mark: the real glyph, monochrome in currentColor, on a quiet tile. */
import { META, type NetworkType } from '../lib/networks';
import { GLYPHS } from '../lib/glyphs';
interface Props { type: NetworkType; size?: number }
const { type, size = 36 } = Astro.props;
const d = GLYPHS[type];
const glyph = Math.round(size * 0.5);
---
<span class="ni" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  {d ? <svg width={glyph} height={glyph} viewBox="0 0 24 24" fill="currentColor"><path d={d} /></svg> : <span class="fb">{META[type].short}</span>}
</span>
<style>
  .ni { display: inline-flex; align-items: center; justify-content: center; flex: none; border-radius: var(--radius); background: var(--bg-elevated); box-shadow: inset 0 0 0 1px var(--border); color: var(--text); }
  .fb { font-family: var(--mono); font-size: 12px; font-weight: 500; }
</style>
