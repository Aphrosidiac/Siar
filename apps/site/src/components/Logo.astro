---
/** The Siar mark (a post fanning out to every network) with a lowercase wordmark. Inherits colour. */
interface Props { size?: number; wordmark?: boolean; class?: string }
const { size = 20, wordmark = true, class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} aria-label="Siar">
  <svg width={size} height={size} viewBox="0.05 -0.8 24 24" fill="none" aria-hidden="true"><path d="M5.6 7.2a4 4 0 1 1-2.4 7.2l-1.6 1.2.5-2.6a4 4 0 0 1 3.5-5.8Z" fill="currentColor"/><path transform="rotate(-38 5.6 11.2)" d="M11 10.5 20 8.7a2.5 2.5 0 0 1 0 5L11 11.9Z" fill="currentColor"/><path transform="rotate(0 5.6 11.2)" d="M11 10.5 20 8.7a2.5 2.5 0 0 1 0 5L11 11.9Z" fill="currentColor"/><path transform="rotate(38 5.6 11.2)" d="M11 10.5 20 8.7a2.5 2.5 0 0 1 0 5L11 11.9Z" fill="currentColor"/></svg>
  {wordmark && <span class="wm">siar</span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 8px; color: var(--text); }
  .wm { font-size: 18px; font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
</style>
