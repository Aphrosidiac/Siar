---
/** The Siar mark (a source dot and two broadcast lines) with a lowercase wordmark. Inherits colour. */
interface Props { size?: number; wordmark?: boolean; class?: string }
const { size = 20, wordmark = true, class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} aria-label="Siar">
  <svg width={size} height={size} viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="4.5" cy="10" r="3" fill="currentColor"/><path d="M10 10h8M10 10l7.2-5.6M10 10l7.2 5.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {wordmark && <span class="wm">siar</span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 8px; color: var(--text); }
  .wm { font-size: 18px; font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
</style>
