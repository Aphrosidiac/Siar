---
/** The Siar mark: a solid tile with a source dot and two broadcast arcs. Neutral, inherits colour. */
interface Props { size?: number; wordmark?: boolean; class?: string }
const { size = 24, wordmark = true, class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} aria-label="Siar">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="currentColor" />
    <circle cx="10" cy="22" r="3" fill="var(--logo-ink, var(--bg))" />
    <path d="M10 13.5a8.5 8.5 0 0 1 8.5 8.5" fill="none" stroke="var(--logo-ink, var(--bg))" stroke-width="3" stroke-linecap="round" />
    <path d="M10 6.5A15.5 15.5 0 0 1 25.5 22" fill="none" stroke="var(--logo-ink, var(--bg))" stroke-width="3" stroke-linecap="round" />
  </svg>
  {wordmark && <span class="wm" style={`font-size:${Math.round(size * 0.8)}px`}>siar</span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 8px; color: var(--fg); }
  .wm { font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
</style>
