---
import { Code } from 'astro:components';
interface Props { tabs: { label: string; lang: string; code: string }[]; id?: string }
const { tabs } = Astro.props;
---
<div class="ct" data-tabs>
  <div class="bar" role="tablist">
    {tabs.map((t, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}>{t.label}</button>)}
  </div>
  {tabs.map((t, i) => (
    <div class="pane" data-pane={i} hidden={i !== 0}>
      <Code code={t.code} lang={t.lang as any} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
    </div>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const btns = root.querySelectorAll<HTMLButtonElement>('.bar button');
    const panes = root.querySelectorAll<HTMLElement>('[data-pane]');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      panes.forEach((p) => (p.hidden = p.dataset.pane !== b.dataset.i));
    }));
  });
</script>
<style>
  .ct { margin: 0 0 20px; min-width: 0; }
  .bar { display: flex; gap: 20px; border: 1px solid var(--code-line); border-bottom-color: var(--code-line); border-radius: var(--radius-lg) var(--radius-lg) 0 0; background: var(--code-bg); padding: 0 16px; overflow-x: auto; }
  .bar button { font: inherit; font-family: var(--mono); font-size: var(--fs-12); line-height: 16px; padding: 11px 0 9px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--code-muted); cursor: pointer; white-space: nowrap; transition: color var(--t-micro); }
  .bar button:hover { color: var(--code-fg); }
  .bar button[aria-selected='true'] { color: var(--code-fg); border-bottom-color: var(--code-fg); }
  .pane :global(pre) { margin: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-top: 0; }
</style>
