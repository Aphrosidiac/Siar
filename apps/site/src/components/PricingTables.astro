---
import { PLANS, TIERS, CAP_COLUMNS, TRIAL_DAYS, dailyPostCaps, dailyCommentCaps, COMMENT_LENGTH, RESOURCE_LIMITS, X_PRICES, X_PRICE_LABELS, X_CREDIT_NOTE, PRICE_LOCK, fmtQuota, fmtInt, fmtMicro, money, isFree, monthsFree } from '../lib/plans';
import { NETWORKS } from '../lib/networks';
import { DM_LINE } from '../lib/status';
import NetIcon from './NetIcon.astro';
interface Props { show?: ('prices' | 'quotas' | 'imports' | 'messaging' | 'caps' | 'comments' | 'length' | 'resources' | 'x')[]; heading?: boolean }
const { show = ['prices', 'quotas', 'imports', 'messaging', 'caps', 'comments', 'length', 'resources', 'x'], heading = true } = Astro.props;
const has = (k: string) => show.includes(k as any);
type T = (typeof TIERS)[number];
const row = (label: string, f: (t: T) => string) => ({ label, cells: TIERS.map(f) });
/** Free's allowances are one-time; every other plan's reset each month. */
const period = (t: T) => (PLANS[t].oneTime ? 'one-time' : 'a month');
const priceCell = (t: T, i: 'MONTHLY' | 'YEARLY', c: 'myr' | 'usd') => (isFree(t) ? 'Free' : money(t, i, c));
const prices = [
  row('A month, Malaysia (ringgit)', (t) => priceCell(t, 'MONTHLY', 'myr')),
  row('A month, elsewhere (USD)', (t) => priceCell(t, 'MONTHLY', 'usd')),
  row('A year, Malaysia (ringgit)', (t) => priceCell(t, 'YEARLY', 'myr')),
  row('A year, elsewhere (USD)', (t) => priceCell(t, 'YEARLY', 'usd')),
  row('Free trial', (t) => (PLANS[t].trial ? `${TRIAL_DAYS} days` : 'No')),
];
const quotas = [
  row('Posts created', (t) => fmtQuota(PLANS[t].posts)),
  row('Comments created', (t) => fmtQuota(PLANS[t].comments)),
  row('Media uploads', (t) => fmtQuota(PLANS[t].uploads)),
  row('Brands (teams)', (t) => fmtQuota(PLANS[t].teams)),
  row('Accounts per brand', () => 'One on every open network'),
  row('Per-account fees', () => 'None'),
  row('REST API and signed webhooks', () => 'Included'),
  row('Analytics', (t) => (PLANS[t].analytics ? 'Included' : 'Not included')),
];
const imports = [
  row('Historical posts per account', (t) => fmtQuota(PLANS[t].importPostsPerAccount)),
  row('Comments stored per imported post', (t) => fmtQuota(PLANS[t].commentImportPerPost)),
  row('Reviews per account', (t) => fmtQuota(PLANS[t].reviewImportPerAccount)),
];
const messaging = [
  row('Direct messages sent per account', (t) => fmtQuota(PLANS[t].dmsPerAccount)),
  row('Automation runs per account', (t) => fmtQuota(PLANS[t].automationRunsPerAccount)),
];
const pc = CAP_COLUMNS.map((c) => dailyPostCaps(c.tier));
const cc = CAP_COLUMNS.map((c) => dailyCommentCaps(c.tier));
/** A row whose value is the same on every plan is one cell across all plan columns. */
const same = (cells: string[]) => cells.every((c) => c === cells[0]);
const NO = new Set(['No', 'None', 'Not included']);
const cls = (t: T | null, c: string, base = 'num') => [base, t === 'PRO' && 'hl', NO.has(c) && 'v-no'].filter(Boolean).join(' ');
const xGroups = (Object.keys(X_PRICES) as (keyof typeof X_PRICES)[]);
---
{has('prices') && (
  <>
    <h3 id="prices">Prices, per organization</h3>
    <div class="table-wrap"><table>
      <thead><tr><th>Plan</th>{TIERS.map((t) => <th class={cls(t, '')}>{PLANS[t].name}</th>)}</tr></thead>
      <tbody>{prices.map((r, ri) => <tr><th scope="row">{r.label}</th>{r.cells.map((c, i) => <td class={cls(TIERS[i], c, ri < 4 && c !== 'Free' && c !== 'Custom' ? 'num price' : 'num')}>{c}</td>)}</tr>)}</tbody>
    </table></div>
    <p class="xs muted">Yearly is {monthsFree('PRO')} months free. {PRICE_LOCK} In Malaysia you pay by card or, for a year at a time, once with FPX or DuitNow. Elsewhere you pay by card. Enterprise is quoted per organization.</p>
  </>
)}
{has('quotas') && (
  <>
    <h3 id="quotas">Quotas, per organization</h3>
    <div class="table-wrap"><table>
      <thead><tr><th>Allowance</th>{TIERS.map((t) => <th class={cls(t, '')}>{PLANS[t].name}<span class="sub">{period(t)}</span></th>)}</tr></thead>
      <tbody>{quotas.map((r) => <tr><th scope="row">{r.label}</th>{same(r.cells) && TIERS.length > 2 ? <td class="v-all" colspan={TIERS.length}>{r.cells[0]}, on every plan</td> : r.cells.map((c, i) => <td class={cls(TIERS[i], c)}>{c}</td>)}</tr>)}</tbody>
    </table></div>
    <p class="xs muted">The free start is a one-time allowance to try Siar. It never resets and has no time limit. Paid plans count per UTC calendar month. Enterprise figures are starting points; each Enterprise organization can have its own quotas.</p>
  </>
)}
{has('imports') && (
  <>
    <h3 id="imports">Import quotas</h3>
    <div class="table-wrap"><table>
      <thead><tr><th>Per connected account</th>{TIERS.map((t) => <th class={cls(t, '')}>{PLANS[t].name}<span class="sub">{period(t)}</span></th>)}</tr></thead>
      <tbody>{imports.map((r) => <tr><th scope="row">{r.label}</th>{same(r.cells) && TIERS.length > 2 ? <td class="v-all" colspan={TIERS.length}>{r.cells[0]}, on every plan</td> : r.cells.map((c, i) => <td class={cls(TIERS[i], c)}>{c}</td>)}</tr>)}</tbody>
    </table></div>
    <p class="xs muted">Per request, on every plan: at most {fmtInt(RESOURCE_LIMITS.historyImportPerCall)} posts per history-import call and {fmtInt(RESOURCE_LIMITS.reviewImportPerCall)} reviews per review-import call.</p>
  </>
)}
{has('messaging') && (
  <>
    <h3 id="messaging">DMs and comment-to-DM automations</h3>
    <div class="table-wrap"><table>
      <thead><tr><th>Per connected account</th>{TIERS.map((t) => <th class={cls(t, '')}>{PLANS[t].name}<span class="sub">{period(t)}</span></th>)}</tr></thead>
      <tbody>{messaging.map((r) => <tr><th scope="row">{r.label}</th>{same(r.cells) && TIERS.length > 2 ? <td class="v-all" colspan={TIERS.length}>{r.cells[0]}, on every plan</td> : r.cells.map((c, i) => <td class={cls(TIERS[i], c)}>{c}</td>)}</tr>)}</tbody>
    </table></div>
    <p class="xs muted">{DM_LINE}</p>
  </>
)}
{has('caps') && (
  <>
    <h3 id="daily-caps">Daily publishing caps, per account</h3>
    <p class="small">Each connected account can receive this many posts per UTC day. The caps protect accounts from being throttled or flagged by the network for publishing too often, so Starter shares Pro's. Enterprise uses the Business caps unless agreed otherwise.</p>
    <div class="table-wrap mid"><table>
      <thead><tr><th>Network</th>{CAP_COLUMNS.map((c) => <th class="num">{c.label}</th>)}</tr></thead>
      <tbody>{NETWORKS.map((n) => <tr><th scope="row"><span class="netcell"><NetIcon type={n.type} size={20} /><a href={`/${n.apiSlug}`}>{n.name}</a></span></th>{pc.map((c) => <td class="num">{fmtInt(c[n.type])}</td>)}</tr>)}</tbody>
    </table></div>
  </>
)}
{has('comments') && (
  <>
    <h3 id="comment-caps">Daily comment caps, per account</h3>
    <div class="table-wrap mid"><table>
      <thead><tr><th>Network</th>{CAP_COLUMNS.map((c) => <th class="num">{c.label}</th>)}</tr></thead>
      <tbody>{NETWORKS.map((n) => <tr><th scope="row"><span class="netcell"><NetIcon type={n.type} size={20} />{n.name}</span></th>{cc.map((c) => <td class="num">{fmtInt(c[n.type])}</td>)}</tr>)}</tbody>
    </table></div>
  </>
)}
{has('length') && (
  <>
    <h3 id="comment-length">Comment length, per network</h3>
    <p class="small">Applies to comments, replies and a post's <code>firstComment</code>. Networks not listed do not take comments through Siar.</p>
    <div class="table-wrap narrow"><table>
      <thead><tr><th>Network</th><th class="num">Max characters</th></tr></thead>
      <tbody>{NETWORKS.filter((n) => COMMENT_LENGTH[n.type] !== undefined).map((n) => <tr><th scope="row"><span class="netcell"><NetIcon type={n.type} size={20} />{n.name}</span></th><td class="num">{fmtInt(COMMENT_LENGTH[n.type]!)}</td></tr>)}</tbody>
    </table></div>
  </>
)}
{has('resources') && (
  <>
    <h3 id="resource-limits">Resource limits, every plan</h3>
    <div class="table-wrap narrow"><table>
      <thead><tr><th>Resource</th><th>Scope</th><th class="num">Limit</th></tr></thead>
      <tbody>
        <tr><td>API keys</td><td>per organization</td><td class="num">{RESOURCE_LIMITS.apiKeys}</td></tr>
        <tr><td>Webhooks</td><td>per organization</td><td class="num">{RESOURCE_LIMITS.webhooks}</td></tr>
        <tr><td>Bot identities</td><td>per team</td><td class="num">{RESOURCE_LIMITS.botsPerTeam}</td></tr>
        <tr><td>Manual retries of a failed post</td><td>per post</td><td class="num">{RESOURCE_LIMITS.maxRetries}</td></tr>
        <tr><td>Media retention after last use</td><td>per upload</td><td class="num">{RESOURCE_LIMITS.mediaRetentionDays} days</td></tr>
      </tbody>
    </table></div>
  </>
)}
{has('x') && (
  <>
    {heading && <h3 id="x-pricing">X (Twitter) pass-through prices</h3>}
    <p class="small">X charges developers for every API call, so X actions are paid from a prepaid credit balance at X's own prices in USD; anything not listed is free. A failed publish is never charged: the amount is held, then taken only on success. {X_CREDIT_NOTE} If the balance runs out, X actions fail with a top-up message and every other network in the same post still publishes.</p>
    <div class="table-wrap mid"><table>
      <thead><tr><th>Action</th><th>Billed</th><th class="num">Price (USD)</th></tr></thead>
      <tbody>{xGroups.map((k) => <tr><td>{X_PRICE_LABELS[k].label}</td><td>{X_PRICE_LABELS[k].unit}</td><td class="num">{fmtMicro(X_PRICES[k])}</td></tr>)}</tbody>
    </table></div>
  </>
)}

<style>
  .sub { display: block; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--text-subtle); }
  table { table-layout: auto; }
  tbody th[scope='row'] { min-width: 200px; font-weight: 500; }
  td.price { color: var(--text); font-weight: 600; font-size: var(--fs-15); }
  thead th.hl { box-shadow: inset 0 2px 0 var(--text); }
  .narrow { max-width: 620px; }
  .mid { max-width: 960px; }
  p.small, p.xs { max-width: 780px; }
  h3 { margin-top: 40px; }
  h3:first-child { margin-top: 0; }
</style>
