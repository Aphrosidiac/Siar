{
  "name": "@siar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^9.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@siar/contract": "workspace:*",
    "@siar/networks": "workspace:*",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.12.1",
    "ioredis": "^5.8.2",
    "nodemailer": "^7.0.10",
    "papaparse": "^5.5.3",
    "pg": "^8.23.0",
    "pg-boss": "^12.28.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "stripe": "^19.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^7.0.2",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.23.1",
    "ajv": "^8.17.1",
    "dotenv": "^17.2.3",
    "prisma": "^7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}